/**
 * Hunting ground recommendations (stub data).
 * Real system must use researched Elanthipedia + map room IDs per instance.
 */

import type { AccountTier, GameInstance } from '../types'
import { capabilitiesFor } from '../lib/accountCapabilities'

export interface HuntingGround {
  id: string
  name: string
  instance: GameInstance
  /** Province / area label */
  area: string
  inZoluren: boolean
  requiresPremium: boolean
  /** Which train focus ids this supports well */
  focus: string[]
  /** 1 easy – 5 hard */
  difficulty: number
  notes?: string
}

