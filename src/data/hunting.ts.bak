export interface RankedHunt {
  ground: HuntingGround
  score: number
  rejected: boolean
  reasons: string[]
}

export function rankHuntingGrounds(opts: {
  instance: GameInstance
  accountTier: AccountTier
  focus: string[]
}): RankedHunt[] {
  const cap = capabilitiesFor(opts.accountTier, opts.instance)
  const focus = opts.focus

  return HUNTING_GROUNDS.map((ground) => {
    const reasons: string[] = []
    let rejected = false
    let score = 50

    if (ground.instance !== opts.instance) {
      rejected = true
      reasons.push(`Wrong instance`)
    }
    if (!rejected && !cap.canTravelOutsideZoluren && !ground.inZoluren) {
      rejected = true
      reasons.push('Outside Zoluren (tier locked)')
    }
    if (
      !rejected &&
      ground.requiresPremium &&
      opts.accountTier !== 'premium' &&
      opts.accountTier !== 'platinum'
    ) {
      rejected = true
      reasons.push('Requires Premium/Platinum')
    }

    if (rejected) {
      return { ground, score: -1, rejected: true, reasons }
    }

    if (focus.length === 0) {
      score += 5
      reasons.push('Balanced default')
    } else {
      const hits = ground.focus.filter((f) => focus.includes(f)).length
      if (hits === 0) {
        score -= 20
        reasons.push('Weak match to focus')
      } else {
        score += hits * 15
        reasons.push(`Matches ${hits} focus skill(s)`)
      }
    }

    // Prefer easier grounds slightly unless advanced_hunt selected
    if (focus.includes('advanced_hunt')) {
      score += ground.difficulty * 4
    } else {
      score += (6 - ground.difficulty) * 3
    }

    return { ground, score: Math.round(score), rejected: false, reasons }
  }).sort((a, b) => {
    if (a.rejected !== b.rejected) return a.rejected ? 1 : -1
    return b.score - a.score
  })
}

export function pickBestHunt(opts: {
  instance: GameInstance
  accountTier: AccountTier
  focus: string[]
}): RankedHunt | null {
  return rankHuntingGrounds(opts).find((r) => !r.rejected) ?? null
}
