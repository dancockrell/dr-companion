; DR Companion — World Viewer (2D isometric)
;
; This project is the viewer FOUNDATION only: a manifest loader, a bridge
; client with explicit mock and authenticated live modes, intent validation,
; event playback, a visibility budget, and an accessible room inspector. The
; WorldRoot scene, camera director and content registry this comment used to
; name were the 3D subsystem and are deleted. The 2D isometric main scene this
; paragraph used to say "has not been authored yet" now exists:
; scenes/room.tscn, composing one room from a forge scene spec. It ships no
; final art - every sprite is a labelled placeholder polygon keyed by kind, so
; real art changes textures and nothing structural. See docs/NO-3D.md at the
; repo root for the direction this project implements.

config_version=5

[application]

config/name="DR Companion World Viewer"
config/description="World/route/room viewer for DR Companion, 2D isometric. Local presentation renderer only: owns no game state, credentials, or topology truth. 3D is cancelled, see ../docs/NO-3D.md."
; `scenes/room.tscn` composes one room from a `forge` scene spec
; through `scripts/room_composer.gd` - the same composer the headless control
; API (`scripts/room_server.gd`) drives, so the window and the bot are looking
; at one tree rather than two implementations of it.
run/main_scene="res://scenes/room.tscn"
; Left at 4.3 deliberately. `tools/godot-tests.mjs` reads this line as the
; project's declared engine and refuses any binary that prints a different
; version, so changing it here would stop every other checkout on this machine
; from running the Godot suite. Nothing added for the room player uses an API
; newer than 4.3; it was run on 4.3.stable and on 4.7.2.stable.mono and the
; results are identical. Migrating the project is a separate, repo-wide call.
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

WorldManifestLoader="*res://scripts/world_manifest_loader.gd"
BridgeClient="*res://scripts/bridge_client.gd"
IntentSender="*res://scripts/intent_sender.gd"
EventPlayer="*res://scripts/event_player.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

; Why this says forward_plus when the direction is 2D isometric
; (../docs/NO-3D.md), asked and answered rather than left as a mixed state:
; Forward+ is Godot's default desktop renderer and it draws 2D perfectly well.
; `window/stretch/mode="canvas_items"` above is the 2D setting that actually
; governs this project. Changing the renderer is the Godot owner's call and it
; is not itself a 3D asset reference, and 3D being cancelled does not decide
; it, so Lane V left the value alone and wrote down why instead of quietly
; flipping a setting it does not own.
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.06, 0.07, 0.09, 1)
