=begin
  companion_bridge.lic — DR Companion protocol v1

  Exposes a localhost-only WebSocket so the DR Companion desktop panel can read
  character state and send high-level intents.

    ;companion_bridge            start on 127.0.0.1:7415
    ;companion_bridge 7500       start on a different port
    ;companion_bridge stop       stop a running bridge

  Contract: docs/BRIDGE_CONTRACT.md

  Design notes
  ------------
  * Pure stdlib. No gems. Lich users should not have to `gem install` anything
    to run a UI, so the WebSocket handshake and framing (RFC 6455) are
    implemented here in about 120 lines rather than pulled from websocket-driver.
  * Binds 127.0.0.1 only. Never 0.0.0.0.
  * Reads state, and only sends game commands for intents the player asked for.
  * Stop is never gated on anything. If the socket is open, stop works.
  * Unimplemented intents are acked with ok:false and a reason. They do not
    silently no-op, and they do not pretend to have worked.
=end

require 'socket'
require 'json'
require 'digest/sha1'
require 'base64'

module Companion
  PROTOCOL      = 1
  BRIDGE_VERSION = '0.4.0'
  DEFAULT_PORT  = 7415
  PATH          = '/companion'
  WS_GUID       = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'

  # ---------------------------------------------------------------- framing --

  module WS
    module_function

    def accept_key(client_key)
      Base64.strict_encode64(Digest::SHA1.digest(client_key.to_s + WS_GUID))
    end

    # Server-to-client frames are never masked.
    def encode(payload, opcode = 0x1)
      bytes = payload.to_s.dup.force_encoding('BINARY')
      out = [0x80 | opcode].pack('C')
      len = bytes.bytesize
      out << if len < 126
               [len].pack('C')
             elsif len < 65_536
               [126, len].pack('Cn')
             else
               [127, len].pack('CQ>')
             end
      out << bytes
      out
    end

    def close_frame(code = 1000, reason = '')
      encode([code].pack('n') + reason.to_s, 0x8)
    end

    # Reads exactly one frame. Returns [opcode, payload] or nil on EOF/error.
    def read_frame(sock)
      head = read_exactly(sock, 2)
      return nil unless head

      b0, b1 = head.unpack('CC')
      opcode = b0 & 0x0f
      masked = (b1 & 0x80) != 0
      len    = b1 & 0x7f

      if len == 126
        ext = read_exactly(sock, 2)
        return nil unless ext
        len = ext.unpack1('n')
      elsif len == 127
        ext = read_exactly(sock, 8)
        return nil unless ext
        len = ext.unpack1('Q>')
      end

      # A client sending us 8MB of anything is a bug or an attack.
      return nil if len > 8 * 1024 * 1024

      mask = nil
      if masked
        mask = read_exactly(sock, 4)
        return nil unless mask
        mask = mask.bytes
      end

      payload = len.zero? ? '' : read_exactly(sock, len)
      return nil if payload.nil?

      if mask
        bytes = payload.bytes
        bytes.each_with_index { |b, i| bytes[i] = b ^ mask[i % 4] }
        payload = bytes.pack('C*')
      end

      [opcode, payload]
    rescue StandardError
      nil
    end

    def read_exactly(sock, n)
      buf = +''
      while buf.bytesize < n
        chunk = begin
          sock.readpartial(n - buf.bytesize)
        rescue EOFError, IOError, Errno::ECONNRESET
          return nil
        end
        return nil if chunk.nil? || chunk.empty?
        buf << chunk
      end
      buf
    end
  end

  # ------------------------------------------------------------------ state --

  # Every reader is defensive. Lich's DR objects are populated by parsing the
  # game stream, so any of them can be missing or stale right after login, and
  # a bridge that raises on a nil is worse than one that reports "unknown".
  module State
    module_function

    def safe(default = nil)
      yield
    rescue StandardError
      default
    end

    def char_name
      safe('') { DRStats.name.to_s }
    end

    def guild
      safe('unknown') { DRStats.guild.to_s.downcase.gsub(/\s+/, '_') }
    end

    def instance
      # Lich knows the game it connected to. DR instances differ in what is
      # navigable, so getting this wrong is worse than admitting we do not know.
      raw = safe('') { XMLData.game.to_s }
      case raw.upcase
      when 'DR'    then 'Prime'
      when 'DRX'   then 'Platinum'
      when 'DRF'   then 'Fallen'
      when 'DRT'   then 'Test'
      else 'Unknown'
      end
    end

    # There is no reliable in-game read for subscription tier, so it is a user
    # setting. Conservative default: unknown, which the UI treats as restricted.
    def account_tier
      t = safe(nil) { CharSettings['companion_account_tier'] }
      t.nil? || t.to_s.empty? ? 'unknown' : t.to_s
    end

    def vitals
      {
        'health'           => safe(0) { DRStats.health.to_i },
        'healthMax'        => 100,
        'spirit'           => safe(0) { DRStats.spirit.to_i },
        'spiritMax'        => 100,
        'fatigue'          => safe(0) { DRStats.fatigue.to_i },
        'fatigueMax'       => 100,
        'concentration'    => safe(0) { DRStats.concentration.to_i },
        'concentrationMax' => 100,
        'mana'             => safe(0) { DRStats.mana.to_i },
        'manaMax'          => 100
      }
    end

    def location
      {
        'roomId'   => safe(nil) { Room.current.id&.to_s },
        'title'    => safe('Unknown') { DRRoom.title.to_s.gsub(/^\[|\]$/, '') },
        'zone'     => safe(nil) { Room.current.location },
        'province' => safe(nil) { CharSettings['companion_province'] },
        'isTown'   => safe(false) { !Room.current.location.nil? },
        'isSafe'   => safe(false) { DRRoom.npcs.empty? }
      }
    end

    # Indicator flags come from the shared Simutronics XML stream. Names differ
    # between games and versions, so probe rather than assume.
    def indicator?(*names)
      ind = safe(nil) { XMLData.indicator }
      return false unless ind.is_a?(Hash)
      names.any? { |n| ind[n].to_s == 'y' }
    end

    def situation
      flags = []
      flags << 'dead'       if indicator?('IconDEAD')
      flags << 'stunned'    if indicator?('IconSTUNNED')
      flags << 'webbed'     if indicator?('IconWEBBED')
      flags << 'prone'      if indicator?('IconPRONE')
      flags << 'bleeding'   if indicator?('IconBLEEDING')
      flags << 'in_combat'  unless safe([]) { DRRoom.npcs }.empty?
      flags << 'roundtime'  if safe(0) { XMLData.roundtime_end.to_f - Time.now.to_f }.positive?

      hp = safe(100) { DRStats.health.to_i }
      flags << 'low_health' if hp.positive? && hp < 35
      flags.uniq
    end

    # Skills with their mindstate. This is the payload the training view needs:
    # ranks alone cannot answer "what should I train", mindstate can.
    def skills
      list = safe([]) { DRSkill.list } || []
      list.map do |s|
        name = safe(nil) { s.name } or next nil
        {
          'name'      => name,
          'ranks'     => safe(0) { DRSkill.getrank(name).to_i },
          'mindstate' => safe(0) { DRSkill.getxp(name).to_i },
          'skillset'  => safe('Lore') { DRSkill.getskillset(name).to_s }
        }
      end.compact
    end

    def status
      {
        'name'        => char_name,
        'instance'    => instance,
        'accountTier' => account_tier,
        'guild'       => guild,
        'race'        => safe(nil) { DRStats.race.to_s },
        'circle'      => safe(0) { DRStats.circle.to_i },
        'favors'      => safe(0) { DRStats.favors.to_i },
        'encumbrance' => safe(nil) { DRStats.encumbrance.to_s },
        'location'    => location,
        'vitals'      => vitals,
        'situation'   => situation,
        'skills'      => skills,
        'activity'    => activity,
        'connected'   => true,
        # Liveness. A live socket does not mean a live game: if this clock
        # stops advancing the game has hung even though the socket is fine.
        # See docs/DOMAIN.md section 13.
        'gameTime'    => safe(0) { Time.now.to_i },
        'roomPlayers' => safe([]) { DRRoom.pcs } || [],
        'groupMembers' => safe([]) { DRRoom.group_members } || []
      }
    end

    def activity
      running = other_scripts.reject { |s| s['status'] == 'paused' }
      return 'Paused' if other_scripts.any? && running.empty?
      return 'Ready' if running.empty?
      running.map { |s| s['name'] }.join(', ')
    end

    def other_scripts
      me = safe(nil) { Script.current.name }
      safe([]) { Script.running }.map do |s|
        n = safe(nil) { s.name }
        next nil if n.nil? || n == me
        { 'name' => n, 'status' => (safe(false) { s.paused? } ? 'paused' : 'running') }
      end.compact
    end

    def inventory
      containers = safe([]) do
        DRCI.get_worn_containers.map { |c| { 'name' => c, 'used' => 0, 'capacity' => 0 } }
      end
      containers = [] unless containers.is_a?(Array)
      {
        'containers' => containers,
        'wornCount'  => safe(0) { GameObj.inv.to_a.size },
        'looseCount' => safe(0) { GameObj.right_hand.id ? 1 : 0 } +
                        safe(0) { GameObj.left_hand.id ? 1 : 0 },
        'pressure'   => 'ok'
      }
    end
  end

  # ------------------------------------------------------------------ trace --

  # In-game testing is going to find that some of the patterns in Patterns are
  # wrong. The difference between that being an afternoon and being a month is
  # whether a tester can see what the game actually said.
  #
  # Trace records every command sent, every reply, and every failed match, and
  # pushes them over the bridge so the panel can show them. A failed match
  # keeps the raw lines, which is the thing you need in order to fix a pattern
  # and the thing that is impossible to recover after the fact.
  module Trace
    @enabled = false
    @sink = nil
    @recent = []

    class << self
      attr_accessor :sink

      def enabled?
        @enabled
      end

      def enable(on = true)
        @enabled = on
      end

      def recent
        @recent
      end

      def event(kind, detail)
        row = {
          'at'     => Time.now.strftime('%H:%M:%S'),
          'kind'   => kind.to_s,
          'detail' => detail.to_s[0, 500]
        }
        # Keep a short tail even when tracing is off, so a tester who turns it
        # on after something went wrong still has the last few lines.
        @recent << row
        @recent.shift while @recent.size > 200

        return unless @enabled
        @sink&.call(row)
      end
    end
  end

  # ---------------------------------------------------------------- patterns --

  # Every string this bridge matches against the game stream, in one place.
  #
  # These come from reading community scripts, not from a live account, so some
  # of them are certainly wrong or incomplete. That is the main thing in-game
  # testing will find, and it is why they live here as data rather than being
  # scattered through the intent handlers: a tester who finds a mismatch should
  # be able to see the pattern, see what the game actually said, and fix one
  # line.
  #
  # `;companion_bridge trace` turns on a mode that reports every send, every
  # reply and every failed match over the bridge, so the panel can show a
  # tester exactly what to change.
  module Patterns
    # The three ways DragonRealms says "not now". A refusal is not a result.
    # See docs/DOMAIN.md section 9.
    REFUSALS = /\.\.\.wait|still stunned|^Sorry, you may only|^\[Please wait/i.freeze

    # Roundtime is printed differently by frontend and situation.
    ROUNDTIME = /^\[?\(?Roundtime:?/i.freeze

    # Per-intent expectations. Keys are stable; values are what we hope to see.
    EXPECT = {
      health: [/You have|You feel|You are in good/i],
      stow:   [/You put|You (?:can't|cannot)|is too/i],
      # Filled in as intents land. Unknown keys fall through to no expectation,
      # which sends the command and does not pretend to have read the answer.
    }.freeze

    def self.expect(key)
      EXPECT[key] || []
    end
  end

  # ---------------------------------------------------------------- runaway --

  # Stop when we are repeating ourselves and getting nowhere.
  #
  # The rule on Prime and Platinum is that automation is monitored, and this is
  # the feature that respects it in practice rather than in a disclaimer. What
  # gets a character noticed is not automation as such: it is a script doing
  # something visibly stupid for a long time.
  #
  # Two real examples from the community, both in docs/DOMAIN.md section 20:
  # a character that teleported through the portal network nine times, passing
  # through its own destination on hop eight and continuing; and one that sat
  # "endlessly looking at the ferry and never getting on".
  #
  # Neither player was doing anything wrong. Their script was. Detecting that
  # and stopping serves them directly, because the character is achieving
  # nothing either way, and it is the difference between automation that is
  # boring and automation that draws a crowd.
  module Runaway
    # Same command this many times with nothing changing.
    REPEAT_LIMIT = 6
    # Same room for this long while still issuing movement.
    STUCK_SECONDS = 180

    @recent = []
    @last_room = nil
    @room_since = Time.now
    @tripped = false

    class << self
      attr_reader :tripped

      def reset
        @recent = []
        @last_room = nil
        @room_since = Time.now
        @tripped = false
      end

      # Called for every command we send. Returns a reason string when the
      # pattern looks like a loop, or nil.
      def observe(command)
        @recent << command.to_s
        @recent.shift while @recent.size > REPEAT_LIMIT * 2

        room = begin
          Room.current&.id
        rescue StandardError
          nil
        end

        if room != @last_room
          @last_room = room
          @room_since = Time.now
        end

        recent = @recent.last(REPEAT_LIMIT)
        if recent.size >= REPEAT_LIMIT && recent.uniq.size == 1
          return trip("sent '#{recent.first}' #{REPEAT_LIMIT} times in a row")
        end

        # Movement that is not moving. The portal loop and the ferry both look
        # like this from the outside.
        if movement?(command) && room && (Time.now - @room_since) > STUCK_SECONDS
          return trip(
            "still in room #{room} after #{STUCK_SECONDS}s of movement commands"
          )
        end

        nil
      end

      def movement?(command)
        command.to_s =~ /\A(go |climb |swim |north|south|east|west|up|down|ne|nw|se|sw|out|in\b)/i
      end

      def trip(reason)
        return nil if @tripped
        @tripped = true
        reason
      end
    end
  end

  # -------------------------------------------------------------------- yaml --

  # Reading the dr-scripts settings a player already has.
  #
  # This is the barrier the whole project is aimed at. To use the main free
  # script suite, a newcomer is asked to:
  #
  #   * read four YAML guides, including anchors and merge keys (&, *, <<: *)
  #   * install VS Code and a YAML plugin
  #   * hand-write a character setup file — the shipped samples run 16 to 21 KB
  #   * override the right keys out of a 94 KB base.yaml without editing it
  #   * debug the result in an online parser, and run ;validate
  #
  # Their own help page says as much: read the guides, use the plugin, "start
  # with small YAML configurations rather than complex ones from other users",
  # run `;validate` and check the output.
  #
  # None of that is unreasonable for the people who wrote it. All of it is a
  # wall for someone who wants to come back to a game and click things. The
  # settings themselves are structured and typed — lists of records with known
  # fields — which is exactly the shape a form handles better than a person
  # counting spaces.
  #
  # So: read what they have, report it, and never write without being asked.
  module Yaml
    module_function

    # Where dr-scripts keeps character settings, relative to Lich's script dir.
    PROFILE_DIRS = [
      %w[dr-scripts profiles],
      %w[profiles],
    ].freeze

    def script_dir
      d = State.safe(nil) { "#{$lich_dir}scripts" }
      return d if d && File.directory?(d)

      # Fall back to walking up from this script's own location.
      here = State.safe(nil) { File.dirname(Script.current.path.to_s) }
      here if here && File.directory?(here)
    end

    def profile_dirs
      base = script_dir
      return [] unless base
      PROFILE_DIRS
        .map { |parts| File.join(base, *parts) }
        .select { |p| File.directory?(p) }
    end

    # Files that apply to this character, in the order dr-scripts loads them:
    # base.yaml, then <Character>-setup.yaml, then <Character>-<Arg>.yaml.
    # Later files win, which is worth showing because it is where surprises
    # come from.
    def files_for(character)
      name = character.to_s.strip
      out = []
      profile_dirs.each do |dir|
        base = File.join(dir, 'base.yaml')
        out << base if File.file?(base)
        next if name.empty?

        Dir.glob(File.join(dir, "#{name}-*.yaml")).sort.each do |f|
          out << f
        end
      end
      out.uniq
    end

    def describe(path)
      {
        'path'  => path,
        'name'  => File.basename(path),
        'bytes' => State.safe(0) { File.size(path) },
        'kind'  => File.basename(path).downcase == 'base.yaml' ? 'defaults' : 'yours'
      }
    end

    # Parse one file and report whether it is valid, with the error if not.
    #
    # A YAML error names a line and column, which is the single most useful
    # thing a person editing one by hand can be told, and the thing an online
    # parser is currently being used for.
    def check(path)
      require 'yaml'
      begin
        data = YAML.unsafe_load_file(path)
        keys = data.is_a?(Hash) ? data.keys.map(&:to_s) : []
        { 'ok' => true, 'keys' => keys.sort, 'count' => keys.size }
      rescue Psych::SyntaxError => e
        {
          'ok'     => false,
          'error'  => e.message.to_s,
          'line'   => e.line,
          'column' => e.column
        }
      rescue StandardError => e
        { 'ok' => false, 'error' => e.message.to_s }
      end
    end
  end

  # --------------------------------------------------------------------- map --

  # Geography, asked of Lich rather than shipped by us.
  #
  # The panel carries a hand-written list of two dozen town names with no room
  # ids attached, which is enough to fill a dropdown and not enough to go
  # anywhere. The obvious-looking fix is to read the Genie map files, since
  # most players have them installed. That is wrong twice over:
  #
  #   * Genie maps are keyed by Genie's own zone-local node ids. Lich has its
  #     own room ids, and those are what `#goto` and every Lich script use.
  #     Lich's Map carries `genie_id`/`genie_zone` per room, which is the only
  #     direction the translation exists in: Lich's map knows about Genie's,
  #     not the reverse.
  #   * The map repository publishes no licence, so copying its contents into
  #     an MIT project is not ours to do.
  #
  # Lich already holds a loaded room graph with Dijkstra pathing, a tag index
  # and uid translation. Asking it is correct by construction and stays current
  # with the player's own map database rather than a snapshot frozen into one
  # of our releases.
  #
  # Everything here is read-only. Nothing in this module moves the character:
  # `preview_path` returns the route instead of walking it, so the panel can
  # show where it is about to go before anyone commits to going.
  module MapInfo
    module_function

    # Lich's Map class, or nil outside Lich. Resolved indirectly because this
    # file is also loaded by the test suite, where no such constant exists.
    def klass
      State.safe(nil) { Lich::Common::Map } || State.safe(nil) { Map }
    end

    def available?
      !klass.nil?
    end

    def current
      State.safe(nil) { klass&.current }
    end

    # Where we are, in both id systems.
    #
    # `id` is Lich's room number, the one `#goto` takes. `uid` is the game's
    # own room id, the number a player sees with ShowRoomID on. They are
    # different numbers for the same room, and confusing them is a documented
    # source of "goto does not work" reports, so both are labelled and sent.
    def here
      room = current
      return { 'available' => false } unless room

      {
        'available' => true,
        'id'        => State.safe(nil) { room.id },
        'uid'       => State.safe(nil) { Array(room.uid).last },
        'title'     => State.safe(nil) { Array(room.title).last.to_s.gsub(/^\[|\]$/, '') },
        'location'  => State.safe(nil) { room.location },
        'climate'   => State.safe(nil) { room.climate },
        'terrain'   => State.safe(nil) { room.terrain },
        'tags'      => State.safe([]) { room.tags.to_a.map(&:to_s) },
        'exits'     => State.safe([]) { room.wayto.keys.map(&:to_s) }
      }
    end

    # The tag vocabulary this player's map actually uses.
    #
    # Not a list we curated. Different map databases carry different tags, and
    # a menu offering "bank" on a map with no bank tagged is worse than one
    # that offers only what is really there.
    def tags
      State.safe([]) { klass&.tags&.map(&:to_s)&.sort } || []
    end

    # Nearest room carrying a tag, and how far away it is in rooms.
    #
    # Returns the room rather than walking to it. The distance is what someone
    # deciding whether to bother actually wants to know.
    def nearest(tag)
      room = current
      return { 'ok' => false, 'reason' => 'no current room' } unless room

      id = State.safe(nil) { room.find_nearest_by_tag(tag.to_s) }
      return { 'ok' => false, 'reason' => "nothing tagged #{tag} is reachable" } unless id

      { 'ok' => true, 'tag' => tag.to_s }
        .merge(describe(id))
        .merge('steps' => path_length(room, id))
    end

    # The route to a room, as ids and titles. Does not move.
    def preview_path(destination)
      room = current
      return { 'ok' => false, 'reason' => 'no current room' } unless room

      dest = destination.to_i
      return { 'ok' => false, 'reason' => 'no destination given' } if dest.zero?

      path = State.safe(nil) { room.path_to(dest) }
      return { 'ok' => false, 'reason' => "no route from #{room.id} to #{dest}" } unless path

      {
        'ok'    => true,
        'from'  => State.safe(nil) { room.id },
        'to'    => dest,
        'steps' => path.length,
        'rooms' => path.map { |rid| describe(rid) }
      }
    end

    def describe(room_id)
      r = State.safe(nil) { klass&.[](room_id) }
      {
        'id'       => room_id,
        'uid'      => State.safe(nil) { Array(r&.uid).last },
        'title'    => State.safe(nil) { Array(r&.title).last.to_s.gsub(/^\[|\]$/, '') },
        'location' => State.safe(nil) { r&.location }
      }
    end

    def path_length(room, id)
      p = State.safe(nil) { room.path_to(id) }
      p ? p.length : nil
    end
  end

  # ---------------------------------------------------------------- commands --

  # Sending a command to DragonRealms is not fire-and-forget. The game refuses
  # in three distinguishable ways and every community script handles all three:
  #
  #     ...wait            you are in roundtime
  #     still stunned      you are stunned
  #     Sorry, you may only    a command-specific refusal
  #
  # Roundtime itself is printed in several formats depending on frontend and
  # situation, so scripts match all of them. This is why "the button did
  # nothing" is the default failure mode in this game, and why anything that
  # sends commands has to go through one place that gets it right.
  #
  # See docs/DOMAIN.md section 9.
  module Cmd
    module_function

    REFUSALS  = Patterns::REFUSALS
    ROUNDTIME = Patterns::ROUNDTIME

    # Wait out any roundtime Lich knows about, bounded so a bad read cannot
    # hang the bridge forever.
    def wait_rt(limit = 20)
      deadline = Time.now + limit
      loop do
        rt = begin
          XMLData.roundtime_end.to_f - Time.now.to_f
        rescue StandardError
          0
        end
        break if rt <= 0
        break if Time.now > deadline
        sleep([rt, 1.0].min)
      end
    end

    # Send `command` and wait for one of `expect`, retrying through refusals.
    #
    # Returns the matched line, or nil on timeout. Never raises: a bridge that
    # dies because the game said something unexpected is worse than one that
    # reports it could not tell.
    def exec(command, expect: [], timeout: 10, attempts: 3, label: nil)
      patterns = Array(expect)
      tag = label ? "#{label}: " : ''

      attempts.times do |try|
        wait_rt

        # Check for a loop, but only on the first attempt. Retrying through
        # roundtime is normal and expected, and counting each retry would make
        # three ordinary calls look like nine repetitions of the same command.
        # The detector is meant to catch a script going nowhere, not a script
        # politely waiting its turn.
        if try.zero? && (reason = Runaway.observe(command))
          Trace.event(:runaway, reason)
          Companion.runaway!(reason)
          return nil
        end

        Trace.event(:send, "#{tag}#{command}#{try.positive? ? " (retry #{try})" : ''}")

        line = begin
          if patterns.empty?
            fput(command)
            return ''
          else
            dothistimeout(command, timeout, Regexp.union(patterns + [REFUSALS]))
          end
        rescue StandardError => e
          Trace.event(:error, "#{tag}#{command} raised: #{e.message}")
          return nil.tap { Companion.log_error("#{command}: #{e.message}") }
        end

        if line.nil?
          # Nothing matched inside the timeout. This is the case a tester needs
          # to see: the pattern is probably wrong, and the raw game text is the
          # only thing that can say what to change it to.
          Trace.event(
            :no_match,
            "#{tag}#{command} — nothing matched /#{patterns.map(&:source).join('/ or /')}/ in #{timeout}s"
          )
          return nil
        end

        Trace.event(:reply, "#{tag}#{line.to_s.strip}")

        # A refusal is not a result. Wait and try again.
        if line =~ REFUSALS
          Trace.event(:refused, "#{tag}#{line.to_s.strip}")
          sleep(1 + try)
          next
        end
        return line
      end

      Trace.event(:gave_up, "#{tag}#{command} — refused #{attempts} times")
      nil
    end

    # Run a command purely for its output, with no expectation of success.
    def send_raw(command)
      wait_rt
      begin
        fput(command)
        true
      rescue StandardError
        false
      end
    end
  end

  # Stop everything and say why.
  #
  # Deliberately the same action as a user pressing Stop: kill the running
  # scripts, tell every connected panel, and leave the character standing still
  # rather than continuing to do something that is not working.
  def self.runaway!(reason)
    respond "[companion] stopping: #{reason}"
    server = $companion_bridge
    return unless server

    server.log(
      "Stopped: #{reason}. Nothing was achieving anything, and a script " \
      'repeating itself is the thing that gets noticed. Check the console, ' \
      'fix it, and start again when you are ready.',
      'error'
    )
    Intents.stop_all(server)
    server.broadcast(type: 'runaway', reason: reason)
  end

  def self.log_error(msg)
    respond "[companion] #{msg}"
  end

  # ---------------------------------------------------------------- intents --

  module Intents
    module_function

    # Intents that must work whenever the socket is open, no matter what the
    # game state looks like. A Stop button that checks preconditions is not a
    # Stop button.
    ALWAYS = %w[stop_all pause resume].freeze

    def handle(intent, args, server)
      case intent
      when 'stop_all' then stop_all(server)
      when 'reset_runaway'
        Runaway.reset
        server.log('Runaway detection reset.')
        [true, 'reset']
      when 'pause'    then pause_all(server)
      when 'resume'   then resume_all(server)
      when 'check_health' then check_health(server)
      when 'stow_all'     then stow_all(server)
      when 'trace_on'
        Trace.enable(true)
        server.log('Trace on. Every command, reply and failed match will appear here.')
        [true, 'trace on']
      when 'trace_off'
        Trace.enable(false)
        server.log('Trace off.')
        [true, 'trace off']
      when 'trace_dump'
        # The tail is kept even when tracing is off, so someone who turns it on
        # after something went wrong still has the last few lines.
        rows = Trace.recent
        server.log("Replaying the last #{rows.size} trace rows.")
        rows.each { |r| server.trace(r) }
        [true, "#{rows.size} rows"]
      when 'read_settings' then read_settings(server)
      when 'check_toggles' then check_toggles(server)
      when 'get_favors'
        [true, "favors: #{State.safe(0) { DRStats.favors.to_i }}"]

      # --- map queries, all read-only -------------------------------------
      #
      # These answer questions rather than taking the character anywhere. A
      # route is shown, never walked; deciding to move stays a separate
      # decision the player makes with the route in front of them.
      when 'map_here' then map_here(server)
      when 'map_tags' then map_tags(server)
      when 'map_nearest' then map_nearest(args, server)
      when 'map_path' then map_path(args, server)

      else
        [false, "'#{intent}' is not implemented in bridge v#{BRIDGE_VERSION} yet. " \
                'The panel can read state and stop scripts; it cannot run this activity.']
      end
    end

    # ------------------------------------------------------------------ map --

    # Every one of these refuses the same way when there is no map, rather than
    # returning an empty result. "No banks nearby" and "I cannot see a map" are
    # different answers, and a panel that shows the first when it means the
    # second sends someone looking for a bank that is on their map already.
    def no_map
      [false, 'No Lich map is loaded. Lich downloads its map database on first ' \
              'connect; if this persists, run ;map in Lich.']
    end

    def map_here(server)
      return no_map unless MapInfo.available?

      here = MapInfo.here
      return [false, 'Lich does not know which room you are in yet.'] unless here['available']

      server.broadcast(type: 'map_here', payload: here)
      # Both numbers, always. They differ, and quoting the wrong one at someone
      # in a help channel wastes an afternoon.
      [true, "room #{here['id']} (game uid #{here['uid']}) — #{here['title']}"]
    end

    def map_tags(server)
      return no_map unless MapInfo.available?

      tags = MapInfo.tags
      server.broadcast(type: 'map_tags', payload: tags)
      [true, tags.empty? ? 'this map carries no tags' : "#{tags.size} tags"]
    end

    def map_nearest(args, server)
      return no_map unless MapInfo.available?

      tag = args.is_a?(Hash) ? args['tag'].to_s : args.to_s
      return [false, 'no tag given'] if tag.empty?

      result = MapInfo.nearest(tag)
      server.broadcast(type: 'map_nearest', payload: result)
      return [false, result['reason']] unless result['ok']

      [true, "#{result['title']} — room #{result['id']}, #{result['steps']} rooms away"]
    end

    def map_path(args, server)
      return no_map unless MapInfo.available?

      dest = args.is_a?(Hash) ? args['to'] : args
      result = MapInfo.preview_path(dest)
      server.broadcast(type: 'map_path', payload: result)
      return [false, result['reason']] unless result['ok']

      # Says "not moving" out loud. A route appearing on screen looks like the
      # start of a journey, and this one is not.
      [true, "#{result['steps']} rooms from #{result['from']} to #{result['to']}. Not moving."]
    end

    # Report the game display settings that change what a parser sees.
    #
    # A player in the community help channel spent a week on a crafting script
    # that insisted they had no materials. The cause was INVBRIEF, a setting

    # Report the dr-scripts YAML this character actually loads.
    #
    # Read-only. It never writes, and it says which files apply and in what
    # order, because "the last file wins" is where the surprises live: a
    # setting in one file quietly overridden by another is the config-shaped
    # failure that shows up in the help channel as a script bug.
    #
    # It also parses each file and reports syntax errors with a line and
    # column, which is what people currently paste into an online parser to
    # find out.
    def read_settings(server)
      character = State.char_name
      files = Yaml.files_for(character)

      if files.empty?
        server.log(
          'No dr-scripts profiles found. That is fine if you do not use them; ' \
          'this app does not require them.'
        )
        return [true, 'no profiles found']
      end

      server.log(
        "dr-scripts settings for #{character}, loaded in this order (later " \
        'files override earlier ones):'
      )

      bad = 0
      files.each do |path|
        info = Yaml.describe(path)
        result = Yaml.check(path)

        if result['ok']
          server.log(
            "  #{info['name']} — #{result['count']} settings, " \
            "#{(info['bytes'] / 1024.0).round(1)} KB"
          )
        else
          bad += 1
          where = result['line'] ? " at line #{result['line']}" : ''
          server.log(
            "  #{info['name']} — will not parse#{where}: #{result['error']}",
            'error'
          )
        end
      end

      server.broadcast(
        type: 'settings',
        character: character,
        files: files.map { |p| Yaml.describe(p).merge(Yaml.check(p)) }
      )

      if bad.positive?
        server.log(
          "#{bad} file(s) will not parse, so dr-scripts is not reading what " \
          'you think it is. The line number above is where to look.',
          'error'
        )
      end

      [true, "#{files.size} file(s), #{bad} broken"]
    end
    # that shortens inventory output: the script was parsing text the game had
    # stopped printing. BRIEF does the same to room descriptions.
    #
    # We report rather than change them. They are the player's settings and
    # some people run BRIEF on purpose. But nobody should lose a week to one.
    def check_toggles(server)
      line = Cmd.exec(
        'toggle',
        expect: [/BRIEF|INVBRIEF|Toggle settings|You have the following/i],
        timeout: 8,
        label: 'toggles'
      )

      if line.nil?
        server.log(
          'Could not read TOGGLE. If parsing looks wrong, check BRIEF and ' \
          'INVBRIEF by hand: both change the text scripts read.',
          'warn'
        )
      else
        server.log("TOGGLE: #{line.to_s.strip}")
        risky = []
        risky << 'INVBRIEF' if line =~ /invbrief\s+(on|yes)/i
        risky << 'BRIEF'    if line =~ /(?<!inv)brief\s+(on|yes)/i

        if risky.empty?
          server.log('No display toggles that would confuse parsing.')
        else
          server.log(
            "#{risky.join(' and ')} is on. That shortens what the game prints, " \
            'which breaks anything reading inventory or room text. Worth ' \
            'turning off while testing.',
            'warn'
          )
        end
      end

      check_room_id_flag(server)
    end

    # ShowRoomID is the one people actually get burned by, and it cuts both
    # ways, which is why it needs explaining rather than just reporting.
    #
    # From the Lich help channel:
    #
    #   "If you used Lich to play, Lich requires the FLAG to be on. But if you
    #    then login without lich into Genie, your maps in genie will be messed
    #    up. The FLAG works with Lich & Genie because Lich disguises the Room
    #    Title display of the ID# automatically so as to not break Genie. But
    #    without Lich, that doesn't happen and your maps will be broke in Genie
    #    until you turn off the FLAG."
    #
    # And the symptom, from someone who lost an afternoon to it:
    #
    #   "the maps simply wont work, #goto does not work and it no longer shows
    #    my position on the map" ... "ShowRoomID was on in flags, have turned it
    #    off. And now goto now works again."
    #
    # So: on is correct while Lich is running, and wrong the moment they play
    # without it. We are running under Lich, so we want it on, and we say the
    # other half out loud because nobody is going to remember it later.
    def check_room_id_flag(server)
      line = Cmd.exec(
        'flags',
        expect: [/ShowRoomID|Flags|You have the following/i],
        timeout: 8,
        label: 'flags'
      )

      if line.nil?
        server.log(
          'Could not read FLAGS. ShowRoomID needs to be ON for Lich to track ' \
          'rooms. Check it with FLAGS if room tracking looks wrong.',
          'warn'
        )
        return [true, 'toggles read, flags unknown']
      end

      on = line =~ /showroomid\s*(?:is\s*)?(on|yes|true)/i

      if on
        server.log(
          'ShowRoomID is on, which is what Lich needs. Remember it the other ' \
          'way round: if you later play without Lich, turn it off again or ' \
          'your frontend mapper will stop working.'
        )
        [true, 'ShowRoomID on']
      else
        server.log(
          'ShowRoomID is off. Lich needs it on to know which room you are in, ' \
          'and without it travel and room tracking will not work. Turn it on ' \
          'with: FLAGS ShowRoomID ON',
          'warn'
        )
        [true, 'ShowRoomID off']
      end
    end

    # Wounds are not in the passive status stream. `check_health` in Lich's
    # commons works by sending HEALTH and parsing the reply, so this is a poll
    # and deliberately not on the status tick.
    #
    # Read-only: it sends one command and reports what came back.
    def check_health(server)
      data = begin
        DRCH.check_health
      rescue StandardError
        nil
      end

      unless data.is_a?(Hash)
        # Fall back to reading the raw reply ourselves rather than giving up.
        line = Cmd.exec('health', expect: [/You have|You feel/i], timeout: 8)
        return [false, 'Could not read health.'] if line.nil?
        server.log(line.to_s)
        return [true, 'health read']
      end

      wounds    = data['wounds'] || {}
      bleeders  = data['bleeders'] || {}
      poisoned  = data['poisoned']
      diseased  = data['diseased']

      count = wounds.values.flatten.size
      bleed = bleeders.values.flatten.size

      if count.zero? && bleed.zero? && !poisoned && !diseased
        server.log('Health: no wounds.')
      else
        server.log(
          "Health: #{count} wound(s), #{bleed} bleeding" \
          "#{poisoned ? ', poisoned' : ''}#{diseased ? ', diseased' : ''}",
          bleed.positive? ? 'warn' : 'info'
        )
        bleeders.each do |severity, list|
          Array(list).each do |w|
            part = begin
              w.body_part
            rescue StandardError
              'unknown'
            end
            server.log("  bleeding #{severity}: #{part}", 'warn')
          end
        end
      end

      [true, "#{count} wounds, #{bleed} bleeding"]
    end

    # Put loose items away. Small, reversible, and a good first thing to let
    # the panel actually do: it touches inventory and nothing else.
    def stow_all(server)
      moved = []
      %w[right left].each do |hand|
        item = begin
          hand == 'right' ? GameObj.right_hand : GameObj.left_hand
        rescue StandardError
          nil
        end
        next if item.nil? || item.id.nil?

        name = begin
          item.noun.to_s
        rescue StandardError
          next
        end
        next if name.empty?

        line = Cmd.exec("stow #{name}", expect: [/You put|You (?:can't|cannot)|is too/i], timeout: 6)
        if line.nil?
          server.log("stow #{name}: no reply", 'warn')
        elsif line =~ /You put/i
          moved << name
        else
          server.log("stow #{name}: #{line}", 'warn')
        end
      end

      if moved.empty?
        server.log('Nothing loose in hand to stow.')
        [true, 'nothing to stow']
      else
        server.log("Stowed #{moved.join(', ')}.")
        [true, "stowed #{moved.size}"]
      end
    end

    def stop_all(server)
      # A deliberate stop clears the loop detector: whatever happens next is
      # a fresh decision by the player, not a continuation.
      Runaway.reset
      killed = []
      me = State.safe(nil) { Script.current.name }
      State.safe([]) { Script.running }.each do |s|
        n = State.safe(nil) { s.name }
        next if n.nil? || n == me
        State.safe(nil) { Script.kill(n) }
        killed << n
      end
      server.log("Stopped: #{killed.empty? ? 'nothing was running' : killed.join(', ')}", 'warn')
      [true, killed.empty? ? 'nothing was running' : "stopped #{killed.size}"]
    end

    def pause_all(server)
      paused = []
      me = State.safe(nil) { Script.current.name }
      State.safe([]) { Script.running }.each do |s|
        n = State.safe(nil) { s.name }
        next if n.nil? || n == me
        next if State.safe(false) { s.paused? }
        State.safe(nil) { Script.pause(n) }
        paused << n
      end
      server.log("Paused: #{paused.join(', ')}") unless paused.empty?
      [true, "paused #{paused.size}"]
    end

    def resume_all(server)
      resumed = []
      me = State.safe(nil) { Script.current.name }
      State.safe([]) { Script.running }.each do |s|
        n = State.safe(nil) { s.name }
        next if n.nil? || n == me
        next unless State.safe(false) { s.paused? }
        State.safe(nil) { Script.unpause(n) }
        resumed << n
      end
      server.log("Resumed: #{resumed.join(', ')}") unless resumed.empty?
      [true, "resumed #{resumed.size}"]
    end
  end

  # ----------------------------------------------------------------- server --

  class Server
    def initialize(port = DEFAULT_PORT)
      @port    = port
      @clients = []
      @lock    = Mutex.new
      @running = false
      @last_status = nil
    end

    def start
      begin
        @server = TCPServer.new('127.0.0.1', @port)
      rescue Errno::EADDRINUSE
        respond "[companion] port #{@port} is already in use. Another bridge may be running."
        return false
      end
      @running = true
      respond "[companion] bridge v#{BRIDGE_VERSION} listening on ws://127.0.0.1:#{@port}#{PATH}"

      Trace.sink = ->(row) { trace(row) }

      @accept_thread = Thread.new { accept_loop }
      @push_thread   = Thread.new { push_loop }
      true
    end

    def stop
      @running = false
      @lock.synchronize do
        @clients.each do |c|
          begin
            c.write(WS.close_frame(1001, 'bridge stopping'))
            c.close
          rescue StandardError
            nil
          end
        end
        @clients.clear
      end
      begin
        @server&.close
      rescue StandardError
        nil
      end
      respond '[companion] bridge stopped.'
    end

    def running?
      @running
    end

    # ------------------------------------------------------------- plumbing --

    def accept_loop
      while @running
        ready = IO.select([@server], nil, nil, 0.5)
        next unless ready
        begin
          sock = @server.accept_nonblock
        rescue IO::WaitReadable, Errno::EINTR
          next
        rescue StandardError
          next
        end
        Thread.new(sock) { |s| serve(s) }
      end
    rescue StandardError => e
      respond "[companion] accept loop ended: #{e.message}"
    end

    def serve(sock)
      return unless handshake(sock)

      @lock.synchronize { @clients << sock }
      send_to(sock, type: 'hello', protocol: PROTOCOL,
                    lichVersion: (defined?(LICH_VERSION) ? LICH_VERSION.to_s : 'unknown'),
                    bridgeVersion: BRIDGE_VERSION)
      send_to(sock, type: 'status', payload: State.status)
      send_to(sock, type: 'inventory', payload: State.inventory)
      send_to(sock, type: 'scripts', payload: State.other_scripts)

      while @running
        frame = WS.read_frame(sock)
        break if frame.nil?
        opcode, payload = frame

        case opcode
        when 0x8 # close
          break
        when 0x9 # ping
          @lock.synchronize { sock.write(WS.encode(payload, 0xA)) rescue nil }
        when 0x1, 0x2
          handle_message(sock, payload)
        end
      end
    rescue StandardError
      nil
    ensure
      @lock.synchronize { @clients.delete(sock) }
      begin
        sock.close
      rescue StandardError
        nil
      end
    end

    def handshake(sock)
      request = +''
      # Read headers, bounded so a non-WebSocket client cannot hang a thread.
      deadline = Time.now + 5
      while Time.now < deadline
        break if request.include?("\r\n\r\n")
        ready = IO.select([sock], nil, nil, 0.5)
        next unless ready
        begin
          request << sock.readpartial(4096)
        rescue EOFError, IOError
          return false
        end
        return false if request.bytesize > 16_384
      end
      return false unless request.include?("\r\n\r\n")

      request_line = request.lines.first.to_s
      unless request_line.include?(PATH)
        sock.write("HTTP/1.1 404 Not Found\r\nConnection: close\r\n\r\n")
        return false
      end

      key = request[/Sec-WebSocket-Key:\s*(\S+)/i, 1]
      unless key
        sock.write("HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n")
        return false
      end

      sock.write(
        "HTTP/1.1 101 Switching Protocols\r\n" \
        "Upgrade: websocket\r\n" \
        "Connection: Upgrade\r\n" \
        "Sec-WebSocket-Accept: #{WS.accept_key(key)}\r\n\r\n"
      )
      true
    rescue StandardError
      false
    end

    def handle_message(sock, raw)
      msg = begin
        JSON.parse(raw)
      rescue StandardError
        send_to(sock, type: 'error', message: 'invalid JSON')
        return
      end
      return unless msg.is_a?(Hash)

      case msg['type']
      when 'ping'
        send_to(sock, type: 'log', line: 'pong')
      when 'subscribe', 'get_status'
        send_to(sock, type: 'status', payload: State.status)
      when 'get_inventory'
        send_to(sock, type: 'inventory', payload: State.inventory)
      when 'intent'
        intent = msg['intent'].to_s
        ok, detail = Intents.handle(intent, msg['args'], self)
        send_to(sock, type: 'intent_ack', intent: intent, ok: ok, detail: detail)
        broadcast(type: 'status', payload: State.status)
        broadcast(type: 'scripts', payload: State.other_scripts)
      else
        send_to(sock, type: 'error', message: "unknown message type: #{msg['type']}")
      end
    end

    def send_to(sock, hash)
      frame = WS.encode(JSON.generate(hash))
      @lock.synchronize do
        begin
          sock.write(frame)
        rescue StandardError
          @clients.delete(sock)
        end
      end
    end

    def broadcast(hash)
      frame = WS.encode(JSON.generate(hash))
      @lock.synchronize do
        @clients.dup.each do |c|
          begin
            c.write(frame)
          rescue StandardError
            @clients.delete(c)
          end
        end
      end
    end

    def log(line, level = 'info')
      broadcast(type: 'log', line: line, level: level)
    end

    # Push a trace row to every connected panel.
    def trace(row)
      broadcast(type: 'trace', row: row)
    end

    # Push status on a slow tick, and immediately when something changed.
    # Skills are large, so compare a cheap digest rather than the whole payload.
    def push_loop
      last_scripts = nil
      while @running
        sleep 1
        next if @clients.empty?

        begin
          status = State.status
          digest = [
            status['vitals'], status['situation'], status['location'],
            status['activity'], status['favors']
          ].to_s

          if digest != @last_status
            @last_status = digest
            broadcast(type: 'status', payload: status)
          end

          scripts = State.other_scripts
          if scripts != last_scripts
            last_scripts = scripts
            broadcast(type: 'scripts', payload: scripts)
          end
        rescue StandardError
          nil
        end
      end
    end
  end
end

# -------------------------------------------------------------------- entry --

arg = Script.current.vars[1].to_s.strip.downcase

if arg == 'stop'
  if $companion_bridge&.running?
    $companion_bridge.stop
    $companion_bridge = nil
  else
    respond '[companion] no bridge is running.'
  end
  exit
end

if $companion_bridge&.running?
  respond '[companion] bridge is already running. Use ";companion_bridge stop" first.'
  exit
end

port = arg =~ /^\d+$/ ? arg.to_i : Companion::DEFAULT_PORT

$companion_bridge = Companion::Server.new(port)
exit unless $companion_bridge.start

Script.at_exit do
  $companion_bridge&.stop
  $companion_bridge = nil
end

# Keep the script alive so Lich does not reap it while the sockets are open.
sleep 1 while $companion_bridge&.running?
