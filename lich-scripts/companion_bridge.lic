=begin
  companion_bridge.lic — DR Companion protocol v1

  Exposes a localhost-only WebSocket so the DR Companion desktop panel can read
  character state and send high-level intents.

    ;companion_bridge            start on 127.0.0.1:7415
    ;companion_bridge 7500       start on a different port
    ;companion_bridge stop       stop a running bridge

  Contract: docs/BRIDGE_CONTRACT.md

  Design notes
  ------------
  * Pure stdlib. No gems. Lich users should not have to `gem install` anything
    to run a UI, so the WebSocket handshake and framing (RFC 6455) are
    implemented here in about 120 lines rather than pulled from websocket-driver.
  * Binds 127.0.0.1 only. Never 0.0.0.0.
  * Reads state, and only sends game commands for intents the player asked for.
  * Stop is never gated on anything. If the socket is open, stop works.
  * Unimplemented intents are acked with ok:false and a reason. They do not
    silently no-op, and they do not pretend to have worked.
=end

require 'socket'
require 'json'
require 'digest/sha1'
require 'base64'
require 'securerandom'

module Companion
  PROTOCOL      = 1
  BRIDGE_VERSION = '0.12.0'
  DEFAULT_PORT  = 7415
  PATH          = '/companion'
  WS_GUID       = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'

  # ------------------------------------------------------------- who may talk --
  #
  # Binding to loopback is not a security boundary, and until 0.9.0 this script
  # behaved as though it were.
  #
  # **The same-origin policy does not restrict WebSockets.** Any page on any
  # origin can open ws://127.0.0.1:7415/companion with no preflight and no CORS
  # block; refusing a foreign origin is the server's job and nothing here did
  # it. The handshake required a path and a Sec-WebSocket-Key, which is exactly
  # what a browser sends anyway, so a web page open in the player's browser
  # while Lich ran could connect and issue intents.
  #
  # What that reached is the part that matters: `stop_all` is in ALWAYS,
  # ungated on purpose because a Stop button must work no matter what the game
  # looks like. Correct for the player, and it meant an attacker got it
  # unconditionally too - a character standing still mid-combat. Plus pause,
  # stow_all, install_mapdb, and a continuous feed of status and inventory to
  # whoever had the tab open.
  #
  # The old test suite asserted "the wrong path is refused, so a stray browser
  # tab cannot attach", which is the false confidence in one line: the path was
  # doing security work it is not capable of. It is a substring match, so
  # /x/companion/y passed too.
  #
  # Two independent gates now, because they stop different attackers.

  # 1. ORIGIN. Stops every web page. A browser always sends Origin and cannot
  #    forge it; nothing else is required to make this effective.
  #
  #    `nil` is allowed deliberately: a missing Origin is what a non-browser
  #    sends, which is the test suite, a CLI client, and any tool somebody
  #    writes later. Allowing it costs nothing against the browser attack and
  #    keeps the door open for things that were never the threat.
  ALLOWED_ORIGINS = [
    # Tauri's webview. The scheme differs by platform and Tauri version, so
    # every form is listed rather than guessed at - and the refusal logs the
    # origin it saw, so a version that invents a new one is a one-line fix
    # rather than a mystery.
    'tauri://localhost',
    'https://tauri.localhost',
    'http://tauri.localhost',
    # The dev server, so `npm run tauri:dev` works against a live bridge.
    'http://localhost:1420',
    'http://127.0.0.1:1420'
  ].freeze

  # 2. TOKEN. Stops a hostile local process, which Origin cannot: anything that
  #    can open a socket can also omit an Origin header.
  #
  #    Written on startup to a file beside this script, readable only by the
  #    user who is running Lich. A client has one second to present it, and the
  #    connection is dropped if it does not - a slow client is indistinguishable
  #    from one that is waiting to see what it can get away with.
  #
  #    This is the weaker half deliberately. Any process running as this user
  #    can read the file, so the token is a boundary against *other software*,
  #    not against something that has already got the user's privileges. Said
  #    plainly rather than implied, because a boundary people overestimate is
  #    worse than one they know the shape of.
  TOKEN_FILE = 'companion_bridge.token'
  TOKEN_GRACE_SECONDS = 1.0

  # ---------------------------------------------------------------- framing --

  module WS
    module_function

    def accept_key(client_key)
      Base64.strict_encode64(Digest::SHA1.digest(client_key.to_s + WS_GUID))
    end

    # Server-to-client frames are never masked.
    def encode(payload, opcode = 0x1)
      bytes = payload.to_s.dup.force_encoding('BINARY')
      out = [0x80 | opcode].pack('C')
      len = bytes.bytesize
      out << if len < 126
               [len].pack('C')
             elsif len < 65_536
               [126, len].pack('Cn')
             else
               [127, len].pack('CQ>')
             end
      out << bytes
      out
    end

    def close_frame(code = 1000, reason = '')
      encode([code].pack('n') + reason.to_s, 0x8)
    end

    # Reads exactly one frame. Returns [opcode, payload] or nil on EOF/error.
    def read_frame(sock)
      head = read_exactly(sock, 2)
      return nil unless head

      b0, b1 = head.unpack('CC')
      opcode = b0 & 0x0f
      masked = (b1 & 0x80) != 0
      len    = b1 & 0x7f

      if len == 126
        ext = read_exactly(sock, 2)
        return nil unless ext
        len = ext.unpack1('n')
      elsif len == 127
        ext = read_exactly(sock, 8)
        return nil unless ext
        len = ext.unpack1('Q>')
      end

      # A client sending us 8MB of anything is a bug or an attack.
      return nil if len > 8 * 1024 * 1024

      mask = nil
      if masked
        mask = read_exactly(sock, 4)
        return nil unless mask
        mask = mask.bytes
      end

      payload = len.zero? ? '' : read_exactly(sock, len)
      return nil if payload.nil?

      if mask
        bytes = payload.bytes
        bytes.each_with_index { |b, i| bytes[i] = b ^ mask[i % 4] }
        payload = bytes.pack('C*')
      end

      [opcode, payload]
    rescue StandardError
      nil
    end

    def read_exactly(sock, n)
      buf = +''
      while buf.bytesize < n
        chunk = begin
          sock.readpartial(n - buf.bytesize)
        rescue EOFError, IOError, Errno::ECONNRESET
          return nil
        end
        return nil if chunk.nil? || chunk.empty?
        buf << chunk
      end
      buf
    end
  end

  # ------------------------------------------------------------------ state --

  # Every reader is defensive. Lich's DR objects are populated by parsing the
  # game stream, so any of them can be missing or stale right after login, and
  # a bridge that raises on a nil is worse than one that reports "unknown".
  module State
    module_function

    # Swallow anything the game module throws and hand back a usable default.
    #
    # `as:` names the payload field this call is producing, and is what makes a
    # swallowed failure visible instead of silent. Optional on purpose: there
    # are over a hundred safe() call sites and most produce values whose
    # emptiness is unambiguous. Only the fields where "empty" and "could not
    # read" are indistinguishable need naming - see degraded_fields.
    def safe(default = nil, as: nil)
      yield
    rescue StandardError
      note_degraded(as) if as
      default
    end

    # Which payload fields had a read fail, for the request being served now.
    #
    # Thread-local rather than module state, and that is not defensive
    # tidiness: serve() spawns a thread per incoming message, so two status
    # builds genuinely overlap. A shared array would attribute one request's
    # failures to another's payload, which is worse than not reporting them -
    # it would name a field that read perfectly well on the request being
    # answered.
    def reset_degraded!
      Thread.current[:drc_degraded] = []
    end

    def note_degraded(field)
      list = Thread.current[:drc_degraded]
      # Nil when a safe(as:) runs outside a payload build. Recording nothing is
      # right there - there is no payload for it to travel on.
      list << field.to_s if list && !list.include?(field.to_s)
    end

    def degraded_fields
      (Thread.current[:drc_degraded] || []).dup
    end

    def char_name
      safe('') { DRStats.name.to_s }
    end

    def guild
      safe('unknown') { DRStats.guild.to_s.downcase.gsub(/\s+/, '_') }
    end

    def instance
      # Lich knows the game it connected to. DR instances differ in what is
      # navigable, so getting this wrong is worse than admitting we do not know.
      raw = safe('') { XMLData.game.to_s }
      case raw.upcase
      when 'DR'    then 'Prime'
      when 'DRX'   then 'Platinum'
      when 'DRF'   then 'Fallen'
      when 'DRT'   then 'Test'
      else 'Unknown'
      end
    end

    # There is no reliable in-game read for subscription tier, so it is a user
    # setting. Conservative default: unknown, which the UI treats as restricted.
    def account_tier
      t = safe(nil) { CharSettings['companion_account_tier'] }
      t.nil? || t.to_s.empty? ? 'unknown' : t.to_s
    end

    # A maximum for a pool the game has not reported yet.
    #
    # Only reached before the first vitals tick, when there is genuinely no
    # answer to give. It is 100 because four of the five pools really are
    # percentages, so on those it is not a guess at all.
    VITAL_MAX_FALLBACK = 100

    def vital_max(reported)
      m = reported.to_i
      m > 0 ? m : VITAL_MAX_FALLBACK
    end

    # Every maximum here used to be the literal 100, and for four of the five
    # that is very nearly right: DragonRealms sends health, mana, stamina and
    # spirit as percentages, so their maximum is 100 and always will be.
    #
    # Concentration is not a percentage. Lich parses "330/330" out of the same
    # XML attribute and keeps both halves - XMLData.concentration and
    # XMLData.max_concentration - and a Circle 1 Bard has 330 of it. So a Bard
    # was reported as 330 out of 100: a bar drawn a long way past its own end
    # and a number that is simply false. Bards spend concentration the way
    # other guilds spend mana, which made it the pool that mattered most to the
    # guild this app was already worst at.
    #
    # Reading the real maximum for all five rather than special-casing the one
    # we happened to catch. The same mistake is waiting in any pool that turns
    # out not to be a percentage, and this closes it for all of them at once.
    def vitals
      {
        'health'           => safe(0) { DRStats.health.to_i },
        'healthMax'        => safe(VITAL_MAX_FALLBACK) { vital_max(XMLData.max_health) },
        'spirit'           => safe(0) { DRStats.spirit.to_i },
        'spiritMax'        => safe(VITAL_MAX_FALLBACK) { vital_max(XMLData.max_spirit) },
        'fatigue'          => safe(0) { DRStats.fatigue.to_i },
        'fatigueMax'       => safe(VITAL_MAX_FALLBACK) { vital_max(XMLData.max_stamina) },
        'concentration'    => safe(0) { DRStats.concentration.to_i },
        'concentrationMax' => safe(VITAL_MAX_FALLBACK) { vital_max(XMLData.max_concentration) },
        'mana'             => safe(0) { DRStats.mana.to_i },
        'manaMax'          => safe(VITAL_MAX_FALLBACK) { vital_max(XMLData.max_mana) }
      }
    end

    def location
      {
        'roomId'   => safe(nil) { Room.current.id&.to_s },
        'title'    => safe('Unknown') { DRRoom.title.to_s.gsub(/^\[|\]$/, '') },
        'zone'     => safe(nil) { Room.current.location },
        'province' => safe(nil) { CharSettings['companion_province'] },
        'isTown'   => safe(false) { !Room.current.location.nil? },
        'isSafe'   => safe(false) { DRRoom.npcs.empty? }
      }
    end

    # Indicator flags come from the shared Simutronics XML stream. Names differ
    # between games and versions, so probe rather than assume.
    def indicator?(*names)
      ind = safe(nil) { XMLData.indicator }
      return false unless ind.is_a?(Hash)
      names.any? { |n| ind[n].to_s == 'y' }
    end

    # The indicator hash the game already sends us, read all the way through.
    #
    # Five of these were being probed and the rest ignored, which meant a
    # character could be poisoned, hidden, kneeling or grouped and the panel
    # showed nothing at all. They cost one hash lookup each and they were
    # already in memory. Probing for a name the game never sends is free and
    # returns false, so listing one that turns out not to exist in DR is not a
    # bug, it is a line that never fires.
    #
    # Posture is three separate icons rather than one field. Standing is the
    # default and is deliberately not reported: a flag that is true almost all
    # the time is not a status, it is furniture.
    def situation
      flags = []
      flags << 'dead'       if indicator?('IconDEAD')
      flags << 'stunned'    if indicator?('IconSTUNNED')
      flags << 'webbed'     if indicator?('IconWEBBED')
      flags << 'prone'      if indicator?('IconPRONE')
      flags << 'kneeling'   if indicator?('IconKNEELING')
      flags << 'sitting'    if indicator?('IconSITTING')
      flags << 'bleeding'   if indicator?('IconBLEEDING')
      flags << 'poisoned'   if indicator?('IconPOISONED')
      flags << 'diseased'   if indicator?('IconDISEASED')
      flags << 'hidden'     if indicator?('IconHIDDEN')
      flags << 'invisible'  if indicator?('IconINVISIBLE')
      flags << 'joined'     if indicator?('IconJOINED')
      flags << 'in_combat'  unless safe([]) { DRRoom.npcs }.empty?
      flags << 'roundtime'  if safe(0) { XMLData.roundtime_end.to_f - Time.now.to_f }.positive?

      hp = safe(100) { DRStats.health.to_i }
      flags << 'low_health' if hp.positive? && hp < 35
      flags.uniq
    end

    # Spells up, and how long they have left.
    #
    # DRSpells.active_spells is a hash of spell name to minutes remaining,
    # maintained by dr-scripts from the game's own spell messaging. It is the
    # only status the game gives us with a real clock on it: everything else in
    # `situation` is an icon that is either lit or not, with no magnitude and no
    # duration behind it.
    #
    # Sorted shortest first, because the only decision this informs is what is
    # about to drop and want recasting.
    #
    # Empty when dr-scripts is not loaded, rather than absent. The client draws
    # nothing either way, and an exception here would take the whole status
    # payload down with it.
    def spells
      raw = safe(nil) { DRSpells.active_spells }
      return [] unless raw.is_a?(Hash)

      raw.map { |name, minutes| { 'name' => name.to_s, 'minutes' => minutes.to_i } }
         .reject { |s| s['name'].empty? }
         .sort_by { |s| s['minutes'] }
    end

    # Whether DRInfomon has finished asking the game for skills yet.
    #
    # DRInfomon.startup_script fires four commands after login (info, played,
    # exp all 0, ability) and DRSkill.list only fills in as their output
    # parses, which takes about a second. A status query that lands in that
    # window sees a genuinely empty list that has nothing to do with the
    # character's guild - a quiet Bard reads exactly like a fresh login. The
    # skill table then stays current on its own via BriefExp as the game
    # plays, so this is a one-time gate on the read, not something to poll.
    #
    # Defaults to true (ready) if the check itself is unavailable, rather than
    # to false: a Lich build without DRInfomon's flag should fall back to the
    # old always-read behaviour, not get stuck reporting "not ready" forever.
    def skills_ready?
      safe(true) { DRInfomon.startup_complete? }
    end

    # Skills with their mindstate. This is the payload the training view needs:
    # ranks alone cannot answer "what should I train", mindstate can.
    #
    # Empty during the startup window above, same as always - the caller
    # tells the two apart using status's 'skillsReady' flag, not by reading
    # meaning into an empty array.
    def skills
      return [] unless skills_ready?

      list = safe([]) { DRSkill.list } || []
      list.map do |s|
        name = safe(nil) { s.name } or next nil
        {
          'name'      => name,
          'ranks'     => safe(0) { DRSkill.getrank(name).to_i },
          'mindstate' => safe(0) { DRSkill.getxp(name).to_i },
          'skillset'  => safe('Lore') { DRSkill.getskillset(name).to_s }
        }
      end.compact
    end

    # Named entities Lich is tracking in the room right now, with as much
    # combat detail as it actually has - not just names, which DRRoom.npcs
    # already sends. This is a genuinely separate feed: Lich::DragonRealms::
    # Creature is built id-first from <crtrStatus> (automatic, every room
    # refresh - hostile/dead/stunned/etc, no name and no range) and enriched
    # from `assess` (name, range bucket, relation, who it's targeting,
    # balance, conditions) whenever a player or script has actually run
    # assess. The two halves arrive on different schedules, which is why
    # `enrichedAgeSeconds` is sent honestly rather than assumed fresh - a
    # creature can be real and current on crtrStatus while its range/target
    # are minutes stale from the last assess. See docs/BRIDGE_CONTRACT.md.
    #
    # Optional module, guarded rather than assumed: it does not touch DRRoom
    # or the plain-string roster every existing script already reads, so a
    # Lich build without it degrades to an empty list, not an error.
    COMBATANT_STATUS_FLAGS = %w[
      stunned prone sitting kneeling sleeping hidden immobilized webbed
      rooted disoriented flying hovering calm
    ].freeze

    def combatants
      return [] unless defined?(Lich::DragonRealms::Creature)

      safe([]) do
        Lich::DragonRealms::Creature.in_room.map do |c|
          {
            'id'                 => safe(nil) { c.id.to_s },
            'name'               => safe(nil) { c.name },
            'noun'               => safe(nil) { c.noun },
            'dead'               => safe(false) { c.crtr_flag?(:dead) },
            'hostile'            => safe(false) { c.crtr_flag?(:hostile) },
            # True once the creature has broken off - still in the room, no
            # longer fighting. The client's honest answer to "not engaged at
            # all", when it can tell rather than guess.
            'disengaged'         => safe(false) { c.crtr_flag?(:disengaged) },
            # 'melee' | 'pole' | 'missile' | nil - nil means not yet assessed
            # this room, not "at range zero". See enrichedAgeSeconds below.
            'range'              => safe(nil) { c.range&.to_s },
            'relation'           => safe(nil) { c.relation },
            'target'             => safe(nil) { c.target },
            'targetNumber'       => safe(nil) { c.target_number },
            'balance'            => safe(nil) { c.balance },
            'offBalance'         => safe(false) { c.off_balance? },
            'conditions'         => safe([]) { c.conditions } || [],
            'statuses'           => COMBATANT_STATUS_FLAGS.select do |f|
              safe(false) { c.flag_active?(f) }
            end,
            # Whole seconds since the last assess enriched this entry, or nil
            # if it never has been. The client's call whether to still show
            # range/target/balance past some age, or grey them out as stale -
            # this field is what makes that an honest choice rather than a
            # guess dressed as current data.
            'enrichedAgeSeconds' => safe(nil) {
              c.enriched? ? (Time.now - c.enriched_at).round : nil
            }
          }
        end
      end || []
    end

    # Held between polls rather than re-read from a passive stream, because DR
    # has none for wounds - Intents.check_health sends HEALTH and parses the
    # reply, on demand, not on this tick. nil means "never successfully
    # polled", the honest unknown state the client's Paperdoll already renders
    # for an absent `injuries` field (see docs/BRIDGE_CONTRACT.md's injuries
    # contract). Once populated, survives every status tick until the next
    # successful check_health overwrites it - a poll that fails or finds
    # nothing new must not blank a part that was last known injured back to
    # "unknown".
    @held_injuries = nil
    @held_bleeding = nil

    # Who is teaching what, from the last `assess teach`. Same contract as
    # injuries above and for the same reason: nil means "never polled", which
    # is not the same as "nobody is teaching" and must not render as it.
    #
    # This cannot ride the status tick. `assess teach` is a real command with
    # a roundtime, so polling it every tick would spend the character's time
    # and spam the game; it is refreshed only when the player asks.
    #
    # Held with the moment it was taken, because a class list is perishable -
    # people finish teaching and leave - and a client showing a ten-minute-old
    # roster as current is worse than one showing nothing.
    @held_teaching = nil
    @held_teaching_at = nil

    def injuries
      @held_injuries
    end

    def bleeding
      @held_bleeding
    end

    def teaching
      @held_teaching
    end

    def teaching_age_seconds
      return nil if @held_teaching_at.nil?
      (Time.now - @held_teaching_at).round
    end

    # Replaces wholesale rather than merging. A class that ended has to
    # disappear, and merging would keep a teacher who has gone - the opposite
    # of the injuries rule above, because these are different kinds of fact:
    # a wound persists until healed, a class roster is only ever a snapshot.
    def record_teaching(list)
      @held_teaching = list
      @held_teaching_at = Time.now
    end

    # DRCH::WOUND_SEVERITY is 1 ("insignificant") to 13 ("useless"); the
    # client's Severity is 0|1|2|3 and the paperdoll's tones are deliberately
    # coarse. See the bucket table in docs/BRIDGE_CONTRACT.md.
    def bucket_severity(sev)
      s = sev.to_i
      return 0 if s <= 0
      return 1 if s <= 4
      return 2 if s <= 8
      3
    end

    # Wound#body_part is a downcased free string ("head", "left arm",
    # "l. eye", "tail", "skin", ...). Maps to the client's BodyPart keys;
    # returns nil for anything with no slot (tail, bare skin) rather than
    # guessing at the nearest limb - callers must log the raw string rather
    # than silently drop it. nsys has no known DR wound source and is never
    # produced here on purpose.
    def map_body_part(raw)
      s = raw.to_s.downcase.strip
      side = if s.start_with?('l.', 'left') then 'left'
             elsif s.start_with?('r.', 'right') then 'right'
             end
      base = s.sub(/\A(?:l\.|r\.|left|right)\s*/, '').strip
      case base
      when 'head' then 'head'
      when 'neck' then 'neck'
      when 'chest' then 'chest'
      when 'abdomen' then 'abdomen'
      when 'back' then 'back'
      when 'eye'  then side == 'left' ? 'leftEye'  : side == 'right' ? 'rightEye'  : nil
      when 'arm'  then side == 'left' ? 'leftArm'  : side == 'right' ? 'rightArm'  : nil
      when 'hand' then side == 'left' ? 'leftHand' : side == 'right' ? 'rightHand' : nil
      when 'leg'  then side == 'left' ? 'leftLeg'  : side == 'right' ? 'rightLeg'  : nil
      when 'foot' then side == 'left' ? 'leftFoot' : side == 'right' ? 'rightFoot' : nil
      end
    end

    # Builds `injuries`/`bleeding` from a HealthResult and stores them held.
    # Called from Intents.check_health, which is why `data` and `server`
    # arrive as arguments rather than being read here. Logs each unmapped raw
    # body-part string once per poll, per the unmapped-parts rule in
    # docs/BRIDGE_CONTRACT.md - a Gor'Tog's tail should be visible as a gap,
    # not silently eaten.
    def record_health(data, server)
      unmapped = []

      # Every field read is defensive - a Wound is whatever DRCH handed back,
      # and this module's own rule (see its header comment) is that a bridge
      # raising on an unexpected shape is worse than one reporting unknown.
      # `.severity`/`.scar?`/`.bleeding_rate` are also simply absent from the
      # lightweight wound stand-ins server_test.rb uses to exercise the count
      # path, so this has to survive that shape too, not only a real Wound.
      #
      # Wound vs scar go to different keys; worst wins when the same part
      # carries more than one wound of the same kind in one poll.
      inj = {}
      (data.wounds || {}).each_value do |list|
        Array(list).each do |w|
          raw_part = safe(nil) { w.body_part }
          next if raw_part.nil?
          part = map_body_part(raw_part)
          unless part
            unmapped << raw_part.to_s
            next
          end
          bucket = bucket_severity(safe(0) { w.severity })
          slot = (inj[part] ||= { 'wound' => 0, 'scar' => 0 })
          field = safe(false) { w.scar? } ? 'scar' : 'wound'
          slot[field] = bucket if bucket > slot[field]
        end
      end
      @held_injuries = inj

      bleed = []
      (data.bleeders || {}).each_value do |list|
        Array(list).each do |w|
          raw_part = safe(nil) { w.body_part }
          part = raw_part.nil? ? nil : map_body_part(raw_part)
          unmapped << raw_part.to_s if raw_part && !part
          bleed << { 'part' => part, 'rate' => safe('') { w.bleeding_rate.to_s } }
        end
      end
      @held_bleeding = bleed

      unmapped.uniq.each { |p| server.log("unmapped wound body part: #{p}", 'warn') }
    end

    def status
      reset_degraded!
      payload = {
        'name'        => char_name,
        'instance'    => instance,
        'accountTier' => account_tier,
        'guild'       => guild,
        'race'        => safe(nil) { DRStats.race.to_s },
        'circle'      => safe(0) { DRStats.circle.to_i },
        'favors'      => safe(0) { DRStats.favors.to_i },
        'encumbrance' => safe(nil) { DRStats.encumbrance.to_s },
        # The eight base stats plus TDPs, luck and native mana type — all
        # already tracked by DRInfomon from the game's own 'exp tdp' and
        # stat-window components, and none of it previously left this
        # module. TDPs in particular is the number a player actually needs
        # before deciding what to train: the Training panel already shows
        # mindstate per skill, but not what there is left to spend.
        # Omitted as a group, not per-field, if the read fails - a
        # half-populated stat block (seven numbers and one degraded gap)
        # reads as more broken than an absent one the client already knows
        # how to say "not asked yet" about.
        'stats' => safe(nil, as: 'stats') {
          {
            'strength'     => DRStats.strength.to_i,
            'stamina'      => DRStats.stamina.to_i,
            'reflex'       => DRStats.reflex.to_i,
            'agility'      => DRStats.agility.to_i,
            'intelligence' => DRStats.intelligence.to_i,
            'wisdom'       => DRStats.wisdom.to_i,
            'discipline'   => DRStats.discipline.to_i,
            'charisma'     => DRStats.charisma.to_i,
            'tdps'         => DRStats.tdps.to_i,
            'luck'         => DRStats.luck.to_i,
            'nativeMana'   => DRStats.native_mana,
          }
        },
        'location'    => location,
        'vitals'      => vitals,
        'situation'   => situation,
        # The only status with a clock on it. See State.spells.
        'spells'      => spells,
        'skills'      => skills,
        # False during DRInfomon's ~1s post-login startup window. See
        # skills_ready? above - an empty 'skills' during that window means
        # "not asked yet", not "this character has no skills".
        'skillsReady' => skills_ready?,
        # True once stop_all has been pressed and stays true until resume -
        # see Intents.@stop_requested. Published so a client can show this
        # before the player finds out the hard way: pressing a macro-bar
        # button while it's true does nothing, and used to do nothing with
        # no explanation anywhere except a bridge log line nobody reads.
        # Absent-safe: an older bridge simply doesn't send it, and false is
        # the correct read for "this bridge doesn't have the concept yet",
        # not a state that needs distinguishing from "known and not latched".
        'stopLatched' => safe(false) { Intents.stop_requested? },
        'activity'    => activity,
        'connected'   => true,
        # Liveness. A live socket does not mean a live game: if this clock
        # stops advancing the game has hung even though the socket is fine.
        # See docs/DOMAIN.md section 13.
        'gameTime'    => safe(0) { Time.now.to_i },
        'roomPlayers' => safe([]) { DRRoom.pcs } || [],
        'groupMembers' => safe([]) { DRRoom.group_members } || [],
        # Creatures, living and dead, as display names. The client derives the
        # noun for art and bestiary lookup rather than us sending it: DRRoom
        # gives strings, and the GameObj list can disagree with them mid-update.
        'roomCreatures' => safe([]) { DRRoom.npcs } || [],
        # Corpses stay reported rather than dropped. A skinnable one with boxes
        # in it is a task the player has not done yet.
        'roomDeadCreatures' => safe([]) { DRRoom.dead_npcs } || [],
        # Combat detail (range, target, balance, statuses) for whatever Lich
        # has assessed - additive to roomCreatures above, not a replacement:
        # this can be a shorter or differently-ordered list, and empty is a
        # real answer ("nobody has assessed yet"), not a failure.
        'roomCombatants' => combatants,
        # Loose items on the floor. GameObj.loot is the game's own list of
        # what is lying here, which is not the same as what a script decided
        # was worth picking up.
        'roomItems' => safe([], as: 'roomItems') { GameObj.loot&.map(&:name) } || [],
        # Both hands by name. This was already read to produce a count, which
        # threw away the only part anyone wanted.
        'hands' => {
          'left'  => safe(nil, as: 'hands.left') { GameObj.left_hand&.name },
          'right' => safe(nil, as: 'hands.right') { GameObj.right_hand&.name }
        },
        # Seconds, not a flag. "You cannot act" is less useful than "for four
        # more seconds", which is the difference between waiting and doing
        # something else.
        'roundtime' => safe(0) {
          [(XMLData.roundtime_end.to_f - Time.now.to_f).round(1), 0].max
        },
        # The character's own footing and who is winning, both off the
        # bracketed line DR prints every combat round:
        #
        #   [You're hurt (86%), nimbly balanced and in better position.]
        #
        # Lich's drparser already reads that line into DRStats.balance and
        # DRStats.position, so nothing here parses anything - this forwards
        # two values it has been keeping all along. Twenty other DRStats
        # fields were already being read a few lines above; these two were
        # simply never picked up.
        #
        # balance is an index into DR_BALANCE_VALUES (twelve steps, from
        # 'completely' off through 'incredibly' balanced). position is a
        # signed magnitude from DR_POSITION_VALUES: negative means the
        # opponent holds the advantage, 0 is an even contest, positive means
        # you do. Both are DragonRealms' own vocabulary from
        # lib/dragonrealms/drinfomon/drvariables.rb - the DR port, not
        # GemStone's side of the same install, whose combat vocabulary
        # differs and must never be substituted here.
        #
        # Sent raw. Turning an index into a word belongs to the client, which
        # already owns every other piece of display vocabulary, and a second
        # copy of the ladder here would be free to drift from Lich's.
        'balance' => safe(nil, as: 'balance') { DRStats.balance },
        'position' => safe(nil, as: 'position') { DRStats.position }
        #
        # There is deliberately no roomAllies here. Lich has no list of
        # creatures fighting on your side: DRRoom.npcs is everything the game
        # bolded, GameObj.type classifies items rather than allegiance, and
        # fam_npcs is the familiar remote view of another room. Sending a guess
        # would put a summon and a thing trying to kill you in the same bucket,
        # which is the one mistake the card decks exist to prevent.
      }
      # injuries/bleeding come from check_health, a poll, not this passive
      # tick - held rather than read here. Omitted entirely until the first
      # successful poll, matching the client's absent-means-unknown contract
      # for CharacterStatus.injuries (the Paperdoll's `known` prop). See
      # docs/BRIDGE_CONTRACT.md's injuries contract.
      unless injuries.nil?
        payload['injuries'] = injuries
        payload['bleeding'] = bleeding
      end

      # Same contract as injuries: the key is absent until someone has asked,
      # so the client can tell "no classes here" (an empty array) from "nobody
      # has looked yet" (no key at all). Those need different words on screen
      # and only one of them is a fact about the room.
      #
      # The age rides along because a class roster goes stale on its own - the
      # teacher finishes and walks off, and nothing tells us. The client
      # decides what to do about that; this just refuses to imply freshness it
      # cannot vouch for.
      t = State.teaching
      unless t.nil?
        payload['teaching'] = t
        payload['teachingAgeSeconds'] = State.teaching_age_seconds
      end
      d = degraded_fields
      payload['degraded'] = d unless d.empty?
      payload
    end

    def activity
      running = other_scripts.reject { |s| s['status'] == 'paused' }
      return 'Paused' if other_scripts.any? && running.empty?
      return 'Ready' if running.empty?
      running.map { |s| s['name'] }.join(', ')
    end

    def other_scripts
      me = safe(nil) { Script.current.name }
      safe([]) { Script.running }.map do |s|
        n = safe(nil) { s.name }
        next nil if n.nil? || n == me
        { 'name' => n, 'status' => (safe(false) { s.paused? } ? 'paused' : 'running') }
      end.compact
    end

    def inventory
      containers = safe([]) do
        DRCI.get_worn_containers.map { |c| { 'name' => c, 'used' => 0, 'capacity' => 0 } }
      end
      containers = [] unless containers.is_a?(Array)
      reset_degraded!
      payload = {
        'containers' => containers,

        # What is worn, by name and not only by count.
        #
        # GameObj.inv has carried the names since the first version of this
        # script and `.size` threw all of them away, which meant the app knew a
        # character was wearing eleven things and could not say what any of
        # them were. That is the same shape as the vitals maximums: the data
        # arrives every tick and the bridge discards it on the way past.
        #
        # It matters because some worn items charge you for something
        # unrelated, and the game does not always say so. Observed on a Bard:
        #
        #   The armor on your head makes playing your cocobolo txistu more
        #   difficult.
        #
        # Nothing else announces that, there is no message when the hat comes
        # off, and it is documented nowhere. Knowing what is worn and what is
        # held is the whole cross-check.
        #
        # Capped, because this is sent on every inventory push and a hoarder
        # with two hundred items would put that on the wire every time for no
        # reading anybody wants. The count above stays authoritative for "how
        # much", so a truncated list never becomes a wrong total.
        'worn'       => safe([], as: 'worn') { GameObj.inv.to_a.map(&:name).compact.first(60) },
        'wornCount'  => safe(0, as: 'wornCount') { GameObj.inv.to_a.size },
        # &.id, not .id: an empty hand is nil, and nil.id raised - which
        # safe() swallowed into the correct answer 0, so nothing ever looked
        # wrong. It only surfaced when `degraded` started naming what was
        # swallowed and an empty pair of hands reported itself as an
        # unreadable field. Its two neighbours above already use &.
        'looseCount' => safe(0, as: 'looseCount') { GameObj.right_hand&.id ? 1 : 0 } +
                        safe(0, as: 'looseCount') { GameObj.left_hand&.id ? 1 : 0 },
        'pressure'   => 'ok'
      }
      d = degraded_fields
      payload['degraded'] = d unless d.empty?
      payload
    end
  end

  # ------------------------------------------------------------------ trace --

  # In-game testing is going to find that some of the patterns in Patterns are
  # wrong. The difference between that being an afternoon and being a month is
  # whether a tester can see what the game actually said.
  #
  # Trace records every command sent, every reply, and every failed match, and
  # pushes them over the bridge so the panel can show them. A failed match
  # keeps the raw lines, which is the thing you need in order to fix a pattern
  # and the thing that is impossible to recover after the fact.
  module Trace
    @enabled = false
    @sink = nil
    @recent = []

    class << self
      attr_accessor :sink

      def enabled?
        @enabled
      end

      def enable(on = true)
        @enabled = on
      end

      def recent
        @recent
      end

      def event(kind, detail)
        row = {
          'at'     => Time.now.strftime('%H:%M:%S'),
          'kind'   => kind.to_s,
          'detail' => detail.to_s[0, 500]
        }
        # Keep a short tail even when tracing is off, so a tester who turns it
        # on after something went wrong still has the last few lines.
        @recent << row
        @recent.shift while @recent.size > 200

        return unless @enabled
        @sink&.call(row)
      end
    end
  end

  # ---------------------------------------------------------------- patterns --

  # Every string this bridge matches against the game stream, in one place.
  #
  # These come from reading community scripts, not from a live account, so some
  # of them are certainly wrong or incomplete. That is the main thing in-game
  # testing will find, and it is why they live here as data rather than being
  # scattered through the intent handlers: a tester who finds a mismatch should
  # be able to see the pattern, see what the game actually said, and fix one
  # line.
  #
  # `;companion_bridge trace` turns on a mode that reports every send, every
  # reply and every failed match over the bridge, so the panel can show a
  # tester exactly what to change.
  module Patterns
    # The three ways DragonRealms says "not now". A refusal is not a result.
    # See docs/DOMAIN.md section 9.
    REFUSALS = /\.\.\.wait|still stunned|^Sorry, you may only|^\[Please wait/i.freeze

    # Roundtime is printed differently by frontend and situation.
    ROUNDTIME = /^\[?\(?Roundtime:?/i.freeze

    # Per-intent expectations. Keys are stable; values are what we hope to see.
    #
    # This table is the whole point of the module comment above - one place a
    # tester can fix - and it only holds that promise if every `expect:` in
    # the file actually reads from it rather than writing its own regex.
    # `health` and the fallback `Cmd.exec('health', expect: [...])` used to be
    # two separate literals and had already drifted: the fallback was missing
    # the `You are in good` alternative present here, so a healthy character's
    # health check would never match on that path. Caught by the table saying
    # something the code no longer did, which is what having one table is for.
    EXPECT = {
      health: [/You have|You feel|You are in good/i],
      stow:   [/You put|You (?:can't|cannot)|is too/i],
      toggle: [/BRIEF|INVBRIEF|Toggle settings|You have the following/i],
      flags:  [/ShowRoomID|Flags|You have the following/i],
      escape: [/You have fled|You can't flee|nowhere to flee|too hurt|You gather yourself/i],
      # Filled in as intents land. Unknown keys fall through to no expectation,
      # which sends the command and does not pretend to have read the answer.
    }.freeze

    def self.expect(key)
      EXPECT[key] || []
    end
  end

  # ---------------------------------------------------------------- runaway --

  # Stop when we are repeating ourselves and getting nowhere.
  #
  # The rule on Prime and Platinum is that automation is monitored, and this is
  # the feature that respects it in practice rather than in a disclaimer. What
  # gets a character noticed is not automation as such: it is a script doing
  # something visibly stupid for a long time.
  #
  # Two real examples from the community, both in docs/DOMAIN.md section 20:
  # a character that teleported through the portal network nine times, passing
  # through its own destination on hop eight and continuing; and one that sat
  # "endlessly looking at the ferry and never getting on".
  #
  # Neither player was doing anything wrong. Their script was. Detecting that
  # and stopping serves them directly, because the character is achieving
  # nothing either way, and it is the difference between automation that is
  # boring and automation that draws a crowd.
  module Runaway
    # Same command this many times with nothing changing.
    REPEAT_LIMIT = 6
    # Same room for this long while still issuing movement.
    STUCK_SECONDS = 180

    # Reachable from two threads at once since per-message dispatch landed:
    # stop_all calls reset from its own thread, deliberately outside
    # CMD_LOCK (a Stop must never wait on that lock), while observe is
    # called from inside Cmd.exec by whichever command-sending intent
    # currently holds it. Investigated rather than left as folklore, per
    # DR Prime's request after downloads-8a flagged it unverified.
    #
    # Determined benign. Every operation here is a plain ivar read/write or
    # an Array method call, each atomic under MRI's GVL individually, so
    # there is no torn-write or corruption path - only two races, and both
    # land on the side that already matches this module's own intent:
    #
    #   - reset reassigns @recent to a fresh array while observe is
    #     mid-sequence on the old one (append, then trim). Ruby resolves the
    #     ivar fresh at each statement, so observe's trailing
    #     `@recent.shift while @recent.size > ...` reads whichever array
    #     `reset` left behind. Worst case: the command observe just appended
    #     is silently lost with the old array object, which just means one
    #     dropped sample in the loop detector at the exact moment a human
    #     already intervened manually - a Stop is a more decisive signal
    #     than an automatic one it happens to overlap.
    #   - reset's `@tripped = false` can land a moment after observe's own
    #     `trip` set it true, un-tripping a detection that fired in the same
    #     instant as the Stop. stop_all's own comment already states the
    #     intended behaviour: "a deliberate stop clears the loop detector:
    #     whatever happens next is a fresh decision by the player." A
    #     manual Stop winning that race is correct, not a bug.
    #
    # No exception path exists in either method that this can trigger, and
    # nothing here is read by code that assumes a stronger consistency
    # guarantee than "reflects some recent state." If CMD_LOCK's scope ever
    # changes, re-check this reasoning rather than assuming it still holds.
    @recent = []
    @last_room = nil
    @room_since = Time.now
    @tripped = false

    class << self
      attr_reader :tripped

      def reset
        @recent = []
        @last_room = nil
        @room_since = Time.now
        @tripped = false
      end

      # Called for every command we send. Returns a reason string when the
      # pattern looks like a loop, or nil.
      def observe(command)
        @recent << command.to_s
        @recent.shift while @recent.size > REPEAT_LIMIT * 2

        room = begin
          Room.current&.id
        rescue StandardError
          nil
        end

        if room != @last_room
          @last_room = room
          @room_since = Time.now
        end

        recent = @recent.last(REPEAT_LIMIT)
        if recent.size >= REPEAT_LIMIT && recent.uniq.size == 1
          return trip("sent '#{recent.first}' #{REPEAT_LIMIT} times in a row")
        end

        # Movement that is not moving. The portal loop and the ferry both look
        # like this from the outside.
        if movement?(command) && room && (Time.now - @room_since) > STUCK_SECONDS
          return trip(
            "still in room #{room} after #{STUCK_SECONDS}s of movement commands"
          )
        end

        nil
      end

      # Anchored per alternative, because only `in` had a boundary and the
      # rest matched any command merely *starting* with those letters.
      #
      # Measured against ordinary DragonRealms commands: 11 of 23 non-movement
      # commands were classified as movement - `search`, `searching`,
      # `sell all`, `send scroll`, `swap`, `sweep`, `nest`, `news`, `nettle`,
      # `outfit`, `upgrade`. Every one of those is something a player types
      # while deliberately standing still.
      #
      # That matters because this predicate is the only gate on the
      # stuck-in-a-room rule, and tripping it calls Intents.stop_all: it kills
      # every running script and latches Stop. So three minutes of selling a
      # pack at one shop counter - `sell all`, `sell backpack`, each matching
      # `se` - ended with the player's automation stopped and a message
      # blaming "movement commands" that were never movement.
      #
      # Over-firing is the direction that gets a safety feature switched off,
      # which costs more than the case it was built for.
      def movement?(command)
        command.to_s =~ /\A(?:go|climb|swim|north|south|east|west|up|down|ne|nw|se|sw|out|in)\b/i
      end

      def trip(reason)
        return nil if @tripped
        @tripped = true
        reason
      end
    end
  end

  # -------------------------------------------------------------------- yaml --

  # Reading the dr-scripts settings a player already has.
  #
  # This is the barrier the whole project is aimed at. To use the main free
  # script suite, a newcomer is asked to:
  #
  #   * read four YAML guides, including anchors and merge keys (&, *, <<: *)
  #   * install VS Code and a YAML plugin
  #   * hand-write a character setup file — the shipped samples run 16 to 21 KB
  #   * override the right keys out of a 94 KB base.yaml without editing it
  #   * debug the result in an online parser, and run ;validate
  #
  # Their own help page says as much: read the guides, use the plugin, "start
  # with small YAML configurations rather than complex ones from other users",
  # run `;validate` and check the output.
  #
  # None of that is unreasonable for the people who wrote it. All of it is a
  # wall for someone who wants to come back to a game and click things. The
  # settings themselves are structured and typed — lists of records with known
  # fields — which is exactly the shape a form handles better than a person
  # counting spaces.
  #
  # So: read what they have, report it, and never write without being asked.
  module Yaml
    module_function

    # Where dr-scripts keeps character settings, relative to Lich's script dir.
    PROFILE_DIRS = [
      %w[dr-scripts profiles],
      %w[profiles],
    ].freeze

    def script_dir
      d = State.safe(nil) { "#{$lich_dir}scripts" }
      return d if d && File.directory?(d)

      # Fall back to walking up from this script's own location.
      here = State.safe(nil) { File.dirname(Script.current.path.to_s) }
      here if here && File.directory?(here)
    end

    def profile_dirs
      base = script_dir
      return [] unless base
      PROFILE_DIRS
        .map { |parts| File.join(base, *parts) }
        .select { |p| File.directory?(p) }
    end

    # Files that apply to this character, in the order dr-scripts loads them:
    # base.yaml, then <Character>-setup.yaml, then <Character>-<Arg>.yaml.
    # Later files win, which is worth showing because it is where surprises
    # come from.
    def files_for(character)
      name = character.to_s.strip
      out = []
      profile_dirs.each do |dir|
        base = File.join(dir, 'base.yaml')
        out << base if File.file?(base)
        next if name.empty?

        Dir.glob(File.join(dir, "#{name}-*.yaml")).sort.each do |f|
          out << f
        end
      end
      out.uniq
    end

    def describe(path)
      {
        'path'  => path,
        'name'  => File.basename(path),
        'bytes' => State.safe(0) { File.size(path) },
        'kind'  => File.basename(path).downcase == 'base.yaml' ? 'defaults' : 'yours'
      }
    end

    # Parse one file and report whether it is valid, with the error if not.
    #
    # A YAML error names a line and column, which is the single most useful
    # thing a person editing one by hand can be told, and the thing an online
    # parser is currently being used for.
    def check(path)
      require 'yaml'
      begin
        data = YAML.unsafe_load_file(path)
        keys = data.is_a?(Hash) ? data.keys.map(&:to_s) : []
        { 'ok' => true, 'keys' => keys.sort, 'count' => keys.size }
      rescue Psych::SyntaxError => e
        {
          'ok'     => false,
          'error'  => e.message.to_s,
          'line'   => e.line,
          'column' => e.column
        }
      rescue StandardError => e
        { 'ok' => false, 'error' => e.message.to_s }
      end
    end
  end

  # --------------------------------------------------------------------- map --

  # Geography, asked of Lich rather than shipped by us.
  #
  # The panel carries a hand-written list of two dozen town names with no room
  # ids attached, which is enough to fill a dropdown and not enough to go
  # anywhere. The obvious-looking fix is to read the Genie map files, since
  # most players have them installed. That is wrong twice over:
  #
  #   * Genie maps are keyed by Genie's own zone-local node ids. Lich has its
  #     own room ids, and those are what `#goto` and every Lich script use.
  #     Lich's Map carries `genie_id`/`genie_zone` per room, which is the only
  #     direction the translation exists in: Lich's map knows about Genie's,
  #     not the reverse.
  #   * The map repository publishes no licence, so copying its contents into
  #     an MIT project is not ours to do.
  #
  # Lich already holds a loaded room graph with Dijkstra pathing, a tag index
  # and uid translation. Asking it is correct by construction and stays current
  # with the player's own map database rather than a snapshot frozen into one
  # of our releases.
  #
  # Everything here is read-only. Nothing in this module moves the character:
  # `preview_path` returns the route instead of walking it, so the panel can
  # show where it is about to go before anyone commits to going.
  module MapInfo
    module_function

    # Lich's Map class, or nil outside Lich. Resolved indirectly because this
    # file is also loaded by the test suite, where no such constant exists.
    def klass
      State.safe(nil) { Lich::Common::Map } || State.safe(nil) { Map }
    end

    def available?
      !klass.nil?
    end

    def current
      State.safe(nil) { klass&.current }
    end

    # Where we are, in both id systems.
    #
    # `id` is Lich's room number, the one `#goto` takes. `uid` is the game's
    # own room id, the number a player sees with ShowRoomID on. They are
    # different numbers for the same room, and confusing them is a documented
    # source of "goto does not work" reports, so both are labelled and sent.
    def here
      room = current
      return { 'available' => false } unless room

      {
        'available' => true,
        'id'        => State.safe(nil) { room.id },
        'uid'       => State.safe(nil) { Array(room.uid).last },
        'title'     => State.safe(nil) { Array(room.title).last.to_s.gsub(/^\[|\]$/, '') },
        'location'  => State.safe(nil) { room.location },
        'climate'   => State.safe(nil) { room.climate },
        'terrain'   => State.safe(nil) { room.terrain },
        'tags'      => State.safe([]) { room.tags.to_a.map(&:to_s) },
        'exits'     => State.safe([]) { room.wayto.keys.map(&:to_s) }
      }
    end

    # The route to a room, as ids and titles. Does not move.
    def preview_path(destination)
      room = current
      return { 'ok' => false, 'reason' => 'no current room' } unless room

      dest = destination.to_i
      return { 'ok' => false, 'reason' => 'no destination given' } if dest.zero?

      path = State.safe(nil) { room.path_to(dest) }
      return { 'ok' => false, 'reason' => "no route from #{room.id} to #{dest}" } unless path

      {
        'ok'    => true,
        'from'  => State.safe(nil) { room.id },
        'to'    => dest,
        'steps' => path.length,
        'rooms' => path.map { |rid| describe(rid) }
      }
    end

    # The closest room or rooms carrying a tag - "nearest bank", "nearest 3
    # healers" - as a computed answer rather than something the player had to
    # have stood in once to save. Does not move, same as preview_path.
    #
    # Built on Room#find_all_nearest_by_tag, which is already in Lich's Map
    # class and already what the community's own tag-based travel (go2's
    # `;go2 bank`, `;go2 healer`) resolves through - this asks the same
    # question Lich already answers rather than re-deriving nearest-by-tag
    # from path_to in a loop over every tagged room, which is the same
    # Dijkstra work Lich's own dijkstra() call already amortises internally.
    def nearest(tag, count = 1)
      room = current
      return { 'ok' => false, 'reason' => 'no current room' } unless room

      t = tag.to_s.strip
      return { 'ok' => false, 'reason' => 'no tag given' } if t.empty?

      n = [count.to_i, 1].max
      ids = State.safe([]) { room.find_all_nearest_by_tag(t) } || []
      return { 'ok' => false, 'reason' => "nothing tagged '#{t}' is reachable from here" } if ids.empty?

      hits = ids.first(n).map do |rid|
        describe(rid).merge('steps' => State.safe(nil) { room.path_to(rid)&.length })
      end

      { 'ok' => true, 'tag' => t, 'from' => State.safe(nil) { room.id }, 'rooms' => hits }
    end

    # Enough of one zone to draw it.
    #
    # This is where the community's map work actually reaches us. Cartographers
    # spent years laying out Elanthia by hand for Genie's automapper, and Lich
    # carries that layout per room as `genie_zone`, `genie_id` and `genie_pos`,
    # keyed to Lich's own room ids. `Map.by_genie_ref` exists as a first-class
    # lookup. So the coordinates that make a map drawable are already here,
    # already translated, already on the player's machine — nothing to parse,
    # nothing to redistribute, and no second copy to go stale.
    #
    # Coordinates are zone-local, which is why this groups by `genie_zone`
    # rather than by `location`: two towns can both have a room at (0, 0), and
    # drawing them on one canvas would stack them.
    #
    # `limit` is real and reported. The Crossing runs to several hundred rooms
    # and a panel that quietly drew the first two hundred would look like a map
    # with a missing district.
    def zone(zone_id = nil, limit = 400)
      k = klass
      return { 'ok' => false, 'reason' => 'no map' } unless k

      room = current
      zid = (zone_id || State.safe(nil) { room&.genie_zone }).to_s
      return { 'ok' => false, 'reason' => 'this room has no zone recorded' } if zid.empty?

      all = State.safe([]) { k.list.compact.select { |r| r.genie_zone.to_s == zid } } || []
      return { 'ok' => false, 'reason' => "no rooms in zone #{zid}" } if all.empty?

      shown = all.first(limit)

      {
        'ok'        => true,
        'zone'      => zid,
        'name'      => State.safe(nil) { shown.first.location },
        'here'      => State.safe(nil) { room&.id },
        'total'     => all.length,
        'truncated' => all.length > shown.length,
        'rooms'     => shown.map { |r| node(r) }
      }
    end

    # One room as a drawable node: position, and edges to rooms in this zone.
    def node(r)
      pos = State.safe(nil) { r.genie_pos }
      x, y, z = coords(pos)

      {
        'id'    => State.safe(nil) { r.id },
        'uid'   => State.safe(nil) { Array(r.uid).last },
        'title' => State.safe(nil) { Array(r.title).last.to_s.gsub(/^\[|\]$/, '') },
        'x'     => x,
        'y'     => y,
        'z'     => z,
        'tags'  => State.safe([]) { r.tags.to_a.map(&:to_s) },
        # Where you can go from here, as Lich room ids. The panel draws an edge
        # only when it also has the other end, so links out of the zone simply
        # do not appear rather than dangling.
        'to'    => State.safe([]) { r.wayto.keys.map(&:to_i) }
      }
    end

    # genie_pos arrives as a string, a hash or an array depending on how the
    # database was written. Accept all three rather than making the shape
    # someone else's problem.
    #
    # The string form is the one that actually ships, and missing it meant the
    # map drew nothing at all. Lich's own downloaded map database stores it as
    # comma-separated text:
    #
    #     "genie_pos": "360,460,0"
    #
    # which is neither a Hash nor an Array, so it fell to the `else` branch and
    # every room came back [nil, nil, nil]. The panel filters on
    # `x !== null && y !== null`, so all of them were discarded and it rendered
    # "No rooms with coordinates on this level" - on a zone where every single
    # room has a position.
    #
    # Measured against the real file rather than inferred: 18,784 rooms, 14,639
    # carrying genie_pos, and The Crossing (genie_zone "1") holding 896 of them
    # with a position on every one. The app was receiving all 896, capping to
    # 400 for drawing, and throwing away the coordinates of all 400.
    #
    # Worth noting why it looked like a map problem and was not: the zone name
    # and room count came through correctly the whole time, because those do
    # not go through here. Only the geometry was lost, so the panel had a real
    # zone with real rooms and nothing it could place.
    def coords(pos)
      case pos
      when Hash
        [pos['x'] || pos[:x], pos['y'] || pos[:y], pos['z'] || pos[:z]]
      when Array
        [pos[0], pos[1], pos[2]]
      when String
        # Split to exactly three, so a trailing field cannot shift z. A short
        # string yields nils for what is absent rather than guessing a zero -
        # a room at an unknown depth is not a room on level 0.
        parts = pos.split(',', 4).map(&:strip)
        [parts[0], parts[1], parts[2]]
      else
        [nil, nil, nil]
      end.map do |v|
        # `to_i` on a non-numeric string is 0, which would place unparseable
        # rooms at the origin in a heap rather than leaving them out. Only
        # convert what actually looks like an integer.
        s = v.to_s.strip
        s.match?(/\A-?\d+\z/) ? s.to_i : nil
      end
    end

    def describe(room_id)
      r = State.safe(nil) { klass&.[](room_id) }
      {
        'id'       => room_id,
        'uid'      => State.safe(nil) { Array(r&.uid).last },
        'title'    => State.safe(nil) { Array(r&.title).last.to_s.gsub(/^\[|\]$/, '') },
        'location' => State.safe(nil) { r&.location }
      }
    end

  end

  # ---------------------------------------------------------------- commands --

  # Sending a command to DragonRealms is not fire-and-forget. The game refuses
  # in three distinguishable ways and every community script handles all three:
  #
  #     ...wait            you are in roundtime
  #     still stunned      you are stunned
  #     Sorry, you may only    a command-specific refusal
  #
  # Roundtime itself is printed in several formats depending on frontend and
  # situation, so scripts match all of them. This is why "the button did
  # nothing" is the default failure mode in this game, and why anything that
  # sends commands has to go through one place that gets it right.
  #
  # See docs/DOMAIN.md section 9.
  module Cmd
    module_function

    REFUSALS  = Patterns::REFUSALS
    ROUNDTIME = Patterns::ROUNDTIME

    # Wait out any roundtime Lich knows about, bounded so a bad read cannot
    # hang the bridge forever.
    def wait_rt(limit = 20)
      deadline = Time.now + limit
      loop do
        rt = begin
          XMLData.roundtime_end.to_f - Time.now.to_f
        rescue StandardError
          0
        end
        break if rt <= 0
        break if Time.now > deadline
        sleep([rt, 1.0].min)
      end
    end

    # Send `command` and wait for one of `expect`, retrying through refusals.
    #
    # Returns the matched line, or nil on timeout. Never raises: a bridge that
    # dies because the game said something unexpected is worse than one that
    # reports it could not tell.
    def exec(command, expect: [], timeout: 10, attempts: 3, label: nil)
      patterns = Array(expect)
      tag = label ? "#{label}: " : ''

      attempts.times do |try|
        wait_rt

        # Check for a loop, but only on the first attempt. Retrying through
        # roundtime is normal and expected, and counting each retry would make
        # three ordinary calls look like nine repetitions of the same command.
        # The detector is meant to catch a script going nowhere, not a script
        # politely waiting its turn.
        if try.zero? && (reason = Runaway.observe(command))
          Trace.event(:runaway, reason)
          Companion.runaway!(reason)
          return nil
        end

        Trace.event(:send, "#{tag}#{command}#{try.positive? ? " (retry #{try})" : ''}")

        line = begin
          if patterns.empty?
            fput(command)
            return ''
          else
            dothistimeout(command, timeout, Regexp.union(patterns + [REFUSALS]))
          end
        rescue StandardError => e
          Trace.event(:error, "#{tag}#{command} raised: #{e.message}")
          return nil.tap { Companion.log_error("#{command}: #{e.message}") }
        end

        if line.nil?
          # Nothing matched inside the timeout. This is the case a tester needs
          # to see: the pattern is probably wrong, and the raw game text is the
          # only thing that can say what to change it to.
          Trace.event(
            :no_match,
            "#{tag}#{command} — nothing matched /#{patterns.map(&:source).join('/ or /')}/ in #{timeout}s"
          )
          return nil
        end

        Trace.event(:reply, "#{tag}#{line.to_s.strip}")

        # A refusal is not a result. Wait and try again.
        if line =~ REFUSALS
          Trace.event(:refused, "#{tag}#{line.to_s.strip}")
          sleep(1 + try)
          next
        end
        return line
      end

      Trace.event(:gave_up, "#{tag}#{command} — refused #{attempts} times")
      nil
    end

    # Run a command purely for its output, with no expectation of success.
    def send_raw(command)
      wait_rt
      begin
        fput(command)
        true
      rescue StandardError
        false
      end
    end
  end

  # Stop everything and say why.
  #
  # Deliberately the same action as a user pressing Stop: kill the running
  # scripts, tell every connected panel, and leave the character standing still
  # rather than continuing to do something that is not working.
  def self.runaway!(reason)
    respond "[companion] stopping: #{reason}"
    server = $companion_bridge
    return unless server

    server.log(
      "Stopped: #{reason}. Nothing was achieving anything, and a script " \
      'repeating itself is the thing that gets noticed. Check the console, ' \
      'fix it, and start again when you are ready.',
      'error'
    )
    Intents.stop_all(server)
    server.broadcast(type: 'runaway', reason: reason)
  end

  def self.log_error(msg)
    respond "[companion] #{msg}"
  end

  # ------------------------------------------------------------------ token --

  # Where the token lives: beside this script, in Lich's own scripts folder.
  #
  # Beside the script rather than somewhere tidier because that is the one
  # directory both halves can find without being told - Lich knows where its
  # scripts are, and the app already locates the Lich install to install this
  # file in the first place.
  def self.token_path
    dir = begin
      File.dirname(Script.current.path.to_s)
    rescue StandardError
      nil
    end
    dir = File.join($lich_dir.to_s, 'scripts') if dir.nil? || dir.empty?
    File.join(dir, TOKEN_FILE)
  end

  # Generated once per start, so a token that leaked yesterday is worthless.
  def self.generate_token
    SecureRandom.hex(32)
  rescue StandardError
    # SecureRandom missing is not a reason to run without a token, it is a
    # reason to say so. Falling back to `rand` would produce something that
    # looks exactly like a token and is guessable, which is worse than none
    # because it invites trust it has not earned.
    nil
  end

  def self.auth_token
    @auth_token
  end

  # Written with the narrowest permissions the platform offers.
  #
  # 0600 is honoured on Unix and largely ignored on Windows, which is stated
  # rather than glossed: on Windows this file is readable by anything running
  # as this user. That is the boundary the token actually draws - other
  # software, not other privilege - and pretending otherwise would be the kind
  # of overstated guarantee that gets somebody hurt.
  # Which gates are actually up: 'token' or 'origin-only'.
  #
  # Reported to every client in the hello frame, because the alternative is a
  # boundary that quietly halves itself and nothing in the system can see it.
  # A red-team pass named this precisely: an unannounced reduction from two
  # gates to one that nothing can observe. The notice went to Lich's log, which
  # the app never reads, and a client presenting a stale token got `true` from
  # line two of `authenticate` without the token being compared to anything -
  # so the *most* broken state looked the most normal.
  def self.auth_mode
    @auth_token.nil? || @auth_token.empty? ? 'origin-only' : 'token'
  end

  # Why the token is absent, when it is. Empty when it is not.
  def self.auth_note
    @auth_note.to_s
  end

  def self.write_token!
    @auth_note = ''
    @auth_token = generate_token

    if @auth_token.nil?
      # An environment missing SecureRandom is deficient through nobody's
      # doing, and continuing on the origin check is clearly right.
      @auth_note = 'SecureRandom unavailable'
      log_error('SecureRandom unavailable: running WITHOUT a token, origin check only')
      clear_stale_token!
      return nil
    end

    path = token_path
    File.open(path, File::WRONLY | File::CREAT | File::TRUNC, 0o600) { |f| f.write(@auth_token) }
    log_error("token written to #{path}")
    path
  rescue StandardError => e
    # Could not write it. A different case from the one above, and they were
    # collapsed until a red-team pass pointed out that only one of them had
    # been argued for: this one means something else is holding the file, and
    # "something is interested in my token file" is a better reason to refuse
    # than to continue.
    #
    # Still continuing, and the reason is evidence rather than optimism.
    # Something on this machine deleted two source files out of a Cargo crate
    # on 26 Aug and left the rest alone - antivirus or a cleanup pass. File
    # interference here is demonstrably not a sign of an attacker, and bricking
    # the bridge on it would make the app unusable for the common cause while
    # protecting against the rare one. A bridge nobody can connect to is not
    # safer, it is broken.
    #
    # What changes is that it is no longer silent: the mode goes out in the
    # hello frame, so the app can say so where somebody is looking.
    @auth_token = nil
    @auth_note = "could not write the token file (#{e.message})"
    log_error("could not write a token (#{e.message}): origin check only")
    clear_stale_token!
    nil
  end

  # Remove a token left by a previous run.
  #
  # The nastiest of the three failure states: the write fails, an old token is
  # still on disk, the client reads it, and it passes every shape check the app
  # applies. It is sent, `authenticate` returns true at line two because
  # `expected` is nil, and the token is never compared to anything. That looks
  # *more* normal than a missing file, because a token was presented.
  #
  # Deleting it makes the origin-only state look like the origin-only state.
  def self.clear_stale_token!
    path = token_path
    return unless File.exist?(path)

    File.delete(path)
    log_error("removed a stale token file at #{path}")
  rescue StandardError => e
    log_error("a stale token file could not be removed (#{e.message}): #{token_path}")
  end

  # Constant-time compare, so the answer does not leak by how long it took.
  def self.same_secret?(a, b)
    a = a.to_s
    b = b.to_s
    return false unless a.bytesize == b.bytesize

    diff = 0
    a.bytes.each_with_index { |byte, i| diff |= byte ^ b.getbyte(i) }
    diff.zero?
  end

  # ---------------------------------------------------------------- intents --

  module Intents
    module_function

    # Intents that must work whenever the socket is open, no matter what the
    # game state looks like. A Stop button that checks preconditions is not a
    # Stop button.
    ALWAYS = %w[stop_all pause resume].freeze

    # Every intent that sends a game command through Cmd.exec/send_raw.
    # Serialized against each other on CMD_LOCK below - never against
    # anything in ALWAYS, which is the entire point.
    #
    # Two reasons this list exists rather than locking inside Cmd.exec
    # itself: it has to cover Runaway's shared @recent/@last_room state too,
    # which nothing inside Cmd.exec touches directly, and a lock taken here
    # is visible at the one place that decides whether an intent may run
    # concurrently with a Stop, rather than buried in a helper three calls
    # deep.
    COMMAND_SENDING = %w[check_toggles check_health stow_all escape run_macro armor_manage].freeze
    CMD_LOCK = Mutex.new

    # Every app window has its own JavaScript runtime, so the frontend's
    # macroFlight gate cannot arbitrate a click in the dashboard against one
    # in a popped-out panel. The bridge process is the first owner shared by
    # every authenticated window. Claim the short flight here, before the
    # longer command lock, so simultaneous requests cannot both become game
    # commands merely because one waited for the other to finish.
    MACRO_FLIGHT_SECONDS = 0.9
    MACRO_FLIGHT_LOCK = Mutex.new
    @macro_claims = {}

    def claim_macro_flight(args, now = Process.clock_gettime(Process::CLOCK_MONOTONIC))
      commands = args.is_a?(Hash) && args['commands'].is_a?(Array) ? args['commands'].map(&:to_s) : []
      fingerprint = JSON.generate(commands)
      MACRO_FLIGHT_LOCK.synchronize do
        @macro_claims.delete_if { |_key, claimed_at| now - claimed_at >= MACRO_FLIGHT_SECONDS }
        return false if @macro_claims.key?(fingerprint)

        @macro_claims[fingerprint] = now
        true
      end
    end

    def reset_macro_flight!
      MACRO_FLIGHT_LOCK.synchronize { @macro_claims = {} }
    end

    # Set by stop_all, checked between iterations by anything in
    # COMMAND_SENDING that loops (stow_all, run_macro). See the threading
    # note on serve() for why this only works now and not before: stop_all
    # runs on its own thread per incoming message, so it can actually reach
    # this flag while a macro is mid-run instead of queuing behind it.
    #
    # Cleared only by resume, not by run_macro/stow_all on entry - that was
    # the bug in the first version of this. FlowDriver sends one run_macro per
    # Task Flow step on its own timer, with nothing wiring stop_all to
    # driver.stop() on the client side. Clearing on entry meant a Stop pressed
    # mid-flow aborted the current step and then got silently wiped the moment
    # the driver's next run_macro arrived, and the flow continued as though
    # nothing had happened - Stop absorbed by exactly the surface it exists to
    # interrupt. Latching until a human decision resumes things, rather than
    # until the next command happens to arrive, is the whole fix. A bare
    # run_macro from the macro bar does not count as that decision.
    @stop_requested = false

    def request_stop!
      @stop_requested = true
    end

    def stop_requested?
      @stop_requested
    end

    def clear_stop!
      @stop_requested = false
    end

    # serve() now spawns a thread per incoming message (see below), so two
    # intents can genuinely be mid-flight at once. Everything that sends a
    # game command queues behind CMD_LOCK instead of interleaving with
    # another one; everything in ALWAYS - and every read-only query - never
    # touches the lock, so it is never stuck behind a long-running macro.
    def handle(intent, args, server)
      # A latched Stop owns the refusal message: run_macro must be allowed to
      # reach its existing Stop check so the player is told to press Resume,
      # rather than seeing the less useful cooldown message. Resume resets the
      # claim below, so the first deliberate macro after it can start at once.
      if intent == 'run_macro' && !stop_requested? && !claim_macro_flight(args)
        server.log('Macro refused: another app window just launched one.', 'warn')
        return [false, 'a macro is still running']
      end

      if COMMAND_SENDING.include?(intent)
        CMD_LOCK.synchronize { dispatch(intent, args, server) }
      else
        dispatch(intent, args, server)
      end
    end

    # One entry per real intent, name mapped to what runs it. This is the
    # thing BRIDGE_CONTRACT.md's implemented-intents contract asked for: a
    # plain `case/when` gives the interpreter no runtime reflection over its
    # own literals, so there was nothing to introspect to build
    # `implementedIntents` honestly. `HANDLERS.keys` is a genuine
    # enumeration of the same object dispatch actually uses - it cannot
    # drift from reality the way a hand-maintained list (or worse, parsing
    # this file's own source text for `when` patterns, which a `when`
    # sitting in a comment or a string would lie to) already has, twice,
    # tonight.
    #
    # Lambdas rather than method symbols so the several intents whose whole
    # body was previously an inline `when` branch (reset_runaway, trace_on,
    # trace_off, trace_dump) don't need a new named method invented purely
    # to have something to dispatch to - the branch just moves here intact.
    HANDLERS = {
      'stop_all' => ->(_args, server) { stop_all(server) },
      'reset_runaway' => lambda { |_args, server|
        Runaway.reset
        server.log('Runaway detection reset.')
        [true, 'reset']
      },
      'pause'    => ->(_args, server) { pause_all(server) },
      'resume'   => ->(_args, server) { resume_all(server) },
      'escape'   => ->(_args, server) { escape(server) },
      'run_macro' => ->(args, server) { run_macro(args, server) },
      'armor_manage' => ->(args, server) { armor_manage(args, server) },
      'check_health' => ->(_args, server) { check_health(server) },
      'check_teaching'  => ->(_args, server) { check_teaching(server) },
      'listen_to'       => ->(args, server)  { listen_to(args, server) },
      'stop_listening'  => ->(_args, server) { stop_listening(server) },
      'stow_all'     => ->(_args, server) { stow_all(server) },
      'trace_on' => lambda { |_args, server|
        Trace.enable(true)
        server.log('Trace on. Every command, reply and failed match will appear here.')
        [true, 'trace on']
      },
      'trace_off' => lambda { |_args, server|
        Trace.enable(false)
        server.log('Trace off.')
        [true, 'trace off']
      },
      'trace_dump' => lambda { |_args, server|
        # The tail is kept even when tracing is off, so someone who turns it
        # on after something went wrong still has the last few lines.
        rows = Trace.recent
        server.log("Replaying the last #{rows.size} trace rows.")
        rows.each { |r| server.trace(r) }
        [true, "#{rows.size} rows"]
      },
      'read_settings' => ->(_args, server) { read_settings(server) },
      'check_toggles' => ->(_args, server) { check_toggles(server) },
      'list_vars'     => ->(_args, server) { list_vars(server) },

      # --- map queries ------------------------------------------------------
      #
      # map_here/map_path/map_zone/install_mapdb are read-only: they answer
      # questions rather than taking the character anywhere. map_walk is the
      # one deliberate exception - clicking a room on the map is now a travel
      # command, at Dan's explicit instruction ("when you click on a location
      # on the map, you go there using lich"), reversing the "not a travel
      # control" design this panel shipped with. See map_walk's own comment
      # for why it delegates to go2 rather than reimplementing movement.
      'map_here' => ->(_args, server) { map_here(server) },
      'map_path' => ->(args, server) { map_path(args, server) },
      'map_walk' => ->(args, server) { map_walk(args, server) },
      'map_nearest' => ->(args, server) { map_nearest(args, server) },
      'map_zone' => ->(args, server) { map_zone(args, server) },
      'install_mapdb' => ->(_args, server) { install_mapdb(server) },
      'list_scripts'  => ->(_args, server) { list_scripts(server) },
      'start_script'  => ->(args, server) { start_script(args, server) },
    }.freeze

    # The three-state contract this feeds (BRIDGE_CONTRACT.md): absent means
    # an older bridge that never advertised anything, present-and-listed
    # means implemented, present-and-not-listed means genuinely refused.
    # Called fresh on every hello rather than cached, so nothing can hold a
    # stale copy across a future reload of this module.
    def implemented_intents
      HANDLERS.keys
    end

    def dispatch(intent, args, server)
      handler = HANDLERS[intent]
      return [false, "'#{intent}' is not implemented in bridge v#{BRIDGE_VERSION} yet. " \
                      'The panel can read state and stop scripts; it cannot run this activity.'] unless handler

      handler.call(args, server)
    end

    # ------------------------------------------------------------------ map --

    # Every one of these refuses the same way when there is no map, rather than
    # returning an empty result. "No banks nearby" and "I cannot see a map" are
    # different answers, and a panel that shows the first when it means the
    # second sends someone looking for a bank that is on their map already.
    def no_map
      [false, 'No Lich map is loaded. Lich downloads its map database on first ' \
              'connect; if this persists, run ;map in Lich.']
    end

    def map_here(server)
      return no_map unless MapInfo.available?

      here = MapInfo.here
      return [false, 'Lich does not know which room you are in yet.'] unless here['available']

      server.broadcast(type: 'map_here', payload: here)
      # Both numbers, always. They differ, and quoting the wrong one at someone
      # in a help channel wastes an afternoon.
      [true, "room #{here['id']} (game uid #{here['uid']}) — #{here['title']}"]
    end

    def map_path(args, server)
      return no_map unless MapInfo.available?

      dest = args.is_a?(Hash) ? args['to'] : args
      result = MapInfo.preview_path(dest)
      server.broadcast(type: 'map_path', payload: result)
      return [false, result['reason']] unless result['ok']

      # Says "not moving" out loud. A route appearing on screen looks like the
      # start of a journey, and this one is not.
      [true, "#{result['steps']} rooms from #{result['from']} to #{result['to']}. Not moving."]
    end

    # Actually walks there, unlike map_path above.
    #
    # Deliberately not a reimplementation of movement. `move()`
    # (lib/global_defs.rb) is a couple hundred lines of DragonRealms-specific
    # recovery - retreating out of combat, unhiding, retrying a door by
    # ordinal, waiting out an ice patch, standing back up after a bad climb -
    # built up over years of bug reports, and go2.lic (installed with the
    # standard Lich script suite) already drives that loop room by room with
    # Dijkstra pathing on top: day passes, portmasters, urchins, the Ta'Vaalor
    # shortcut, elemental confluence handling. Re-deriving any slice of that
    # here would be slower to build, worse per fix, and a second copy of logic
    # that already has its own maintainers - the same §7 reasoning
    # install_mapdb above already applies to fetching the map database.
    #
    # Started, not awaited - same reason install_mapdb doesn't wait for its
    # download: this method is called from the socket-handling thread, and
    # blocking it for the length of a cross-zone walk would freeze every other
    # panel until the character arrived. go2 runs as its own Lich script
    # (Script.start), so Stop/Escape already reaches it - stop_all kills every
    # running script by name, go2 included, with nothing new to wire up.
    #
    # A bare room number is go2's own "just go there" form (go2.lic: a numeric
    # target skips its confirmation prompt entirely, `confirm = false`), which
    # is exactly the contract this needs: no interactive prompt for a bridge
    # request to get stuck waiting on.
    def map_walk(args, server)
      # A latched Stop refuses this before anything else, including the map
      # lookup. map_walk is the only intent that moves the character, and it
      # does it by starting go2 - a script that keeps sending movement
      # commands on its own long after the click, which makes it a larger
      # commitment than the run_macro the @stop_requested note already says
      # "does not count as that decision".
      #
      # Without this, pressing Stop and then clicking a room walked the
      # character away while the bridge was still publishing
      # stopLatched=true to the panel: Stop absorbed by exactly the surface
      # it exists to interrupt, which is the failure that note was written
      # about. Measured before the fix - go2 was started with the latch set.
      #
      # Deliberately not modelled on the Rust side's pause gate, which lets a
      # player type `stand` while paused. That is one command the player
      # issues and watches; this starts an autonomous traveller.
      if stop_requested?
        return [false, 'Stop is still latched - press Resume before travelling.']
      end

      return no_map unless MapInfo.available?

      dest = (args.is_a?(Hash) ? args['to'] : args).to_i
      return [false, 'no destination given'] if dest.zero?

      room = MapInfo.current
      return [false, 'Lich does not know which room you are in yet.'] unless room
      return [true, 'already there'] if State.safe(nil) { room.id } == dest

      path = State.safe(nil) { room.path_to(dest) }
      return [false, "no route from #{State.safe(nil) { room.id }} to #{dest}"] unless path

      return [false, 'go2 is not installed. Install the standard Lich script suite to travel by click.'] \
        unless State.safe(false) { Script.exists?('go2') }

      already_walking = State.safe([]) { Script.running }.any? do |s|
        State.safe(nil) { s.name }.to_s.casecmp?('go2')
      end
      return [false, 'already traveling (go2 is running) - stop it, or wait for it to arrive, first'] if already_walking

      started = State.safe(false) { Script.start('go2', dest.to_s) }
      return [false, 'could not start go2'] unless started

      server.log("Walking to room #{dest} (#{path.length} rooms) via go2.")
      [true, "walking to #{dest} (#{path.length} rooms)"]
    end

    # The nearest bank, the nearest three healers - a computed answer, not a
    # saved one. args: { tag: string, count?: number }. Read-only, like
    # map_path: it says where the nearest tagged room is, it does not go there
    # - the client fires map_walk itself against whichever hit it picks.
    def map_nearest(args, server)
      return no_map unless MapInfo.available?

      tag = args.is_a?(Hash) ? args['tag'] : args
      count = args.is_a?(Hash) ? (args['count'] || 1) : 1
      result = MapInfo.nearest(tag, count)
      server.broadcast(type: 'map_nearest', payload: result)
      return [false, result['reason']] unless result['ok']

      [true, "#{result['rooms'].length} '#{result['tag']}' room(s) found"]
    end

    # Fetch Lich's map database by running the script that already does it.
    #
    # Worth being explicit about why this is not a download in our Rust side,
    # where every other dependency is handled. The map database does not come
    # from GitHub. `download-prime-map.lic` opens a TLS connection to
    # repo.lichproject.org on port 7157, verifies it against a CA certificate
    # embedded in the script, speaks the Lich project's own protocol, and
    # gunzips what comes back. Reimplementing that would be fragile — we would
    # be tracking somebody else's wire format and shipping a copy of their
    # pinned certificate — and it would be presumptuous, because their script
    # is right there and is maintained.
    #
    # So this is the §7 rule in its purest form: a script already does it, so
    # start it and report what happened.
    def install_mapdb(server)
      # download-prime-map.lic refuses outright on Prime - `exit`, before
      # doing anything else, on the literal check `XMLData.game == "DR"`
      # (download-prime-map.lic:258) - with the message "This script is not
      # intended to be used on the Prime DR instance. Use standard lich
      # commands to manage your map." It exists for Platinum/Fallen only.
      #
      # install_mapdb used to try it first for every instance, gated only on
      # whether the file existed on disk, never on whether it would actually
      # run. For a Prime character that file always exists and always
      # refuses, and Script.start still returns truthy because the script
      # did start - it just exited immediately. The bridge reported "started,
      # the map will fill in" and never learned otherwise, which is almost
      # certainly why this has been reported as silently producing nothing.
      #
      # repository.lic's own `download-mapdb` command handles Prime as game
      # code 'dr' with no such restriction (repository.lic's
      # determine_mapdb_game), so it is the correct route there - "standard
      # lich commands", exactly as download-prime-map's own refusal says to
      # use.
      candidates = State.instance == 'Prime' ? %w[repository] : %w[download-prime-map repository]
      script = candidates.find do |name|
        State.safe(false) { Script.exists?(name) }
      end

      unless script
        return [false, "None of #{candidates.join(', ')} is installed. " \
                       'Install the script suite first.']
      end

      args = script == 'repository' ? ['download-mapdb'] : []
      server.log("Running #{script} to fetch the map database. This takes a moment.")

      started = State.safe(false) { Script.start(script, *args) }
      return [false, "could not start #{script}"] unless started

      # Deliberately not waiting for it. It is a network fetch of a large file
      # and blocking the bridge thread on it would freeze every other panel.
      # The map panel notices the database the next time it asks for a zone.
      [true, "#{script} started. The map will fill in once it finishes."]
    end

    # ---------------------------------------------------------------- scripts --
    #
    # Lich already knows how to watch, pause, resume and stop whatever is
    # running (State.other_scripts, stop_all, pause_all, resume_all). It had
    # no way to start something new, which made every script in the library
    # invisible to the app except by typing its name straight into Lich. These
    # two close that gap without growing a second copy of Lich's own resolver.

    # Every launchable file, wherever Lich would actually find it.
    #
    # Mirrors Script.__find_script_file's search order (custom/ root, each
    # custom/<subdir>/, then SCRIPT_DIR) and its accepted extensions
    # (lic/rb/cmd/wiz, optionally gz/Z-compressed) rather than a flat *.lic
    # glob, which would silently have hidden every custom script and every
    # non-.lic one — including anything a player wrote themselves. Excludes
    # this script by name, the same way State.other_scripts excludes it from
    # the running list: a control that starts a second bridge racing for the
    # same port is not a script anyone meant to offer.
    def list_scripts(server)
      exts = /\.(?:lic|rb|cmd|wiz)(?:\.(?:gz|Z))?\z/i
      me = State.safe(nil) { Script.current.name.to_s.downcase }

      names = State.safe([]) do
        custom_base = File.join(SCRIPT_DIR, 'custom')
        custom_dirs = File.directory?(custom_base) ? [custom_base] + Dir.glob(File.join(custom_base, '*/')).map { |p| p.chomp('/') } : []

        (custom_dirs.flat_map { |dir| Dir.children(dir) } + Dir.children(SCRIPT_DIR))
          .select { |f| f =~ exts }
          .map { |f| f.sub(exts, '') }
          .uniq { |n| n.downcase }
          .reject { |n| n.downcase == me }
          .sort
      end

      server.broadcast(type: 'script_catalog', payload: names)
      [true, "#{names.size} scripts"]
    end

    # Launch one, by name only — no arguments reach the script in this
    # version. That is deliberate: the map intents above document why client
    # input should never become text a script or the game interprets, and a
    # script's own argument parsing is exactly that surface one layer further
    # away. Add arguments later only after reviewing what a specific
    # launchable script does with them.
    def start_script(args, server)
      # Same latch as map_walk, and for the stronger reason: server_test.rb
      # calls this "the only intent that causes Lich to execute arbitrary"
      # code. A Stop that still lets a hunting script be started is not a
      # Stop.
      #
      # This extends the @stop_requested note's own standard rather than
      # inventing one. That note says a bare run_macro "does not count as
      # that decision" - and pressing Start on a script list is the same kind
      # of act as pressing a macro button, one layer more consequential.
      # Resume is the decision; this is not.
      if stop_requested?
        return [false, 'Stop is still latched - press Resume before starting a script.']
      end

      name = args.is_a?(Hash) ? args['name'].to_s : args.to_s
      return [false, 'no script name given'] if name.empty?
      return [false, "'#{name}' is not a valid script name"] unless name =~ /\A[\w.\-]+\z/

      return [false, "no script named '#{name}'"] unless State.safe(false) { Script.exists?(name) }

      # Best-effort, not a guarantee: another client can start the same
      # script between this check and Script.start below. Script.start
      # refuses a true duplicate on its own (Lich tracks that by name in its
      # own registry), so the race costs at most a less specific error
      # message here, never a double-started script.
      already = State.other_scripts.any? { |s| s['name'].to_s.casecmp?(name) }
      return [false, "'#{name}' is already running"] if already

      started = State.safe(false) { Script.start(name) }
      return [false, "could not start '#{name}'"] unless started

      server.log("started #{name}")
      [true, "#{name} started"]
    end

    def map_zone(args, server)
      return no_map unless MapInfo.available?

      zid = args.is_a?(Hash) ? args['zone'] : args
      result = MapInfo.zone(zid)
      server.broadcast(type: 'map_zone', payload: result)
      return [false, result['reason']] unless result['ok']

      note = result['truncated'] ? " (of #{result['total']}, capped)" : ''
      [true, "zone #{result['zone']}: #{result['rooms'].length} rooms#{note}"]
    end

    # Report the game display settings that change what a parser sees.
    #
    # A player in the community help channel spent a week on a crafting script
    # that insisted they had no materials. The cause was INVBRIEF, a setting

    # Report the dr-scripts YAML this character actually loads.
    #
    # Read-only. It never writes, and it says which files apply and in what
    # order, because "the last file wins" is where the surprises live: a
    # setting in one file quietly overridden by another is the config-shaped
    # failure that shows up in the help channel as a script bug.
    #
    # It also parses each file and reports syntax errors with a line and
    # column, which is what people currently paste into an online parser to
    # find out.
    # Lich::Common::Vars is per-character persistent storage every script can
    # read and write (Vars['x'] = y), backed by SQLite and separate entirely
    # from dr-scripts' YAML profiles above. `;vars list` has always been able
    # to show them; nothing on this app's side could until now.
    #
    # Read-only on purpose, for the same reason `read_settings` only reads:
    # scripts other than this one own these values, and a bridge feature for
    # a person to change one from here is a bigger decision than reporting
    # what is already set - it can wait for its own scoping conversation.
    def list_vars(server)
      character = State.char_name
      all = Vars.list

      if all.empty?
        server.log("No variables set for #{character}.")
        server.broadcast(type: 'vars', character: character, entries: [])
        return [true, 'no vars set']
      end

      entries = all.sort_by { |name, _| name.to_s }.map do |name, value|
        if value.is_a?(String)
          { name: name.to_s, value: value, kind: 'string' }
        else
          # Lich's own GUI (vars.lic) does the same thing for anything that
          # is not a String: shows class and inspect, and does not offer to
          # edit it. Matching that rather than inventing a new display rule
          # for types this bridge has never seen (Vars can hold booleans,
          # or whatever a script decided to marshal into it).
          { name: name.to_s, value: "#{value.class}: #{value.inspect}", kind: 'other' }
        end
      end

      server.log("#{entries.size} variable(s) set for #{character}.")
      server.broadcast(type: 'vars', character: character, entries: entries)
      [true, "#{entries.size} var(s)"]
    end

    def read_settings(server)
      character = State.char_name
      files = Yaml.files_for(character)

      if files.empty?
        server.log(
          'No dr-scripts profiles found. That is fine if you do not use them; ' \
          'this app does not require them.'
        )
        return [true, 'no profiles found']
      end

      server.log(
        "dr-scripts settings for #{character}, loaded in this order (later " \
        'files override earlier ones):'
      )

      bad = 0
      files.each do |path|
        info = Yaml.describe(path)
        result = Yaml.check(path)

        if result['ok']
          server.log(
            "  #{info['name']} — #{result['count']} settings, " \
            "#{(info['bytes'] / 1024.0).round(1)} KB"
          )
        else
          bad += 1
          where = result['line'] ? " at line #{result['line']}" : ''
          server.log(
            "  #{info['name']} — will not parse#{where}: #{result['error']}",
            'error'
          )
        end
      end

      server.broadcast(
        type: 'settings',
        character: character,
        files: files.map { |p| Yaml.describe(p).merge(Yaml.check(p)) }
      )

      if bad.positive?
        server.log(
          "#{bad} file(s) will not parse, so dr-scripts is not reading what " \
          'you think it is. The line number above is where to look.',
          'error'
        )
      end

      [true, "#{files.size} file(s), #{bad} broken"]
    end
    # that shortens inventory output: the script was parsing text the game had
    # stopped printing. BRIEF does the same to room descriptions.
    #
    # We report rather than change them. They are the player's settings and
    # some people run BRIEF on purpose. But nobody should lose a week to one.
    def check_toggles(server)
      line = Cmd.exec(
        'toggle',
        expect: Patterns.expect(:toggle),
        timeout: 8,
        label: 'toggles'
      )

      # Only ever true or nil, never false. The regexes below are a positive
      # match on the toggle being reported on; there is no verified pattern
      # here for a confirmed *off*, and "did not match" is not the same claim
      # as "the game told us it's off" - collapsing them would be exactly the
      # kind of confidently-wrong answer this app has been burned by before.
      # ShowRoomID gets the stronger claim below because that branch already
      # shipped and has been trusted in production reasoning; this one has not.
      brief = nil
      inv_brief = nil

      if line.nil?
        server.log(
          'Could not read TOGGLE. If parsing looks wrong, check BRIEF and ' \
          'INVBRIEF by hand: both change the text scripts read.',
          'warn'
        )
      else
        server.log("TOGGLE: #{line.to_s.strip}")
        inv_brief = true if line =~ /invbrief\s+(on|yes)/i
        brief = true if line =~ /(?<!inv)brief\s+(on|yes)/i

        risky = []
        risky << 'INVBRIEF' if inv_brief
        risky << 'BRIEF'    if brief

        if risky.empty?
          server.log('No display toggles that would confuse parsing.')
        else
          server.log(
            "#{risky.join(' and ')} is on. That shortens what the game prints, " \
            'which breaks anything reading inventory or room text. Worth ' \
            'turning off while testing.',
            'warn'
          )
        end
      end

      success, message, show_room_id = check_room_id_flag(server)

      # Everything here already crossed the socket as a log line; this is the
      # same information a status field can hold instead of a person having
      # to have been watching the log pane at the right moment.
      server.broadcast(
        type: 'toggles',
        brief: brief,
        invBrief: inv_brief,
        showRoomId: show_room_id
      )

      [success, message]
    end

    # ShowRoomID is the one people actually get burned by, and it cuts both
    # ways, which is why it needs explaining rather than just reporting.
    #
    # From the Lich help channel:
    #
    #   "If you used Lich to play, Lich requires the FLAG to be on. But if you
    #    then login without lich into Genie, your maps in genie will be messed
    #    up. The FLAG works with Lich & Genie because Lich disguises the Room
    #    Title display of the ID# automatically so as to not break Genie. But
    #    without Lich, that doesn't happen and your maps will be broke in Genie
    #    until you turn off the FLAG."
    #
    # And the symptom, from someone who lost an afternoon to it:
    #
    #   "the maps simply wont work, #goto does not work and it no longer shows
    #    my position on the map" ... "ShowRoomID was on in flags, have turned it
    #    off. And now goto now works again."
    #
    # So: on is correct while Lich is running, and wrong the moment they play
    # without it. We are running under Lich, so we want it on, and we say the
    # other half out loud because nobody is going to remember it later.
    def check_room_id_flag(server)
      line = Cmd.exec(
        'flags',
        expect: Patterns.expect(:flags),
        timeout: 8,
        label: 'flags'
      )

      if line.nil?
        server.log(
          'Could not read FLAGS. ShowRoomID needs to be ON for Lich to track ' \
          'rooms. Check it with FLAGS if room tracking looks wrong.',
          'warn'
        )
        return [true, 'toggles read, flags unknown', nil]
      end

      on = line =~ /showroomid\s*(?:is\s*)?(on|yes|true)/i

      if on
        server.log(
          'ShowRoomID is on, which is what Lich needs. Remember it the other ' \
          'way round: if you later play without Lich, turn it off again or ' \
          'your frontend mapper will stop working.'
        )
        [true, 'ShowRoomID on', true]
      else
        server.log(
          'ShowRoomID is off. Lich needs it on to know which room you are in, ' \
          'and without it travel and room tracking will not work. Turn it on ' \
          'with: FLAGS ShowRoomID ON',
          'warn'
        )
        [true, 'ShowRoomID off', false]
      end
    end

    # Wounds are not in the passive status stream. `check_health` in Lich's
    # commons works by sending HEALTH and parsing the reply, so this is a poll
    # and deliberately not on the status tick.
    #
    # Read-only: it sends one command and reports what came back.
    def check_health(server)
      data = begin
        DRCH.check_health
      rescue StandardError
        nil
      end

      # DRCH.check_health returns a HealthResult
      # (lib/dragonrealms/commons/common-healing.rb:405) on success - a
      # plain class, attr_reader only, no Hash ancestor and no `[]`. Checked
      # by interface (respond_to?) rather than by class name so this
      # doesn't care whether Lich renames or wraps the type, as long as
      # whatever comes back still answers .wounds. This used to be
      # `data.is_a?(Hash)`, which is never true for the real return type -
      # every successful call fell through to the fallback below, and the
      # accessors past this point used to be `data['wounds']` etc., Hash
      # subscript syntax that would have raised NoMethodError on a
      # HealthResult the moment the gate was fixed without also fixing
      # them. Both bugs found together; a gate that can never pass had
      # been hiding a broken body the whole time nobody could reach it.
      unless data.respond_to?(:wounds)
        # Fall back to reading the raw reply ourselves rather than giving up.
        line = Cmd.exec('health', expect: Patterns.expect(:health), timeout: 8)
        return [false, 'Could not read health.'] if line.nil?
        server.log(line.to_s)
        return [true, 'health read']
      end

      # Populates State's held injuries/bleeding for the next status tick to
      # pick up - lives in State, not here, because that is where `status`
      # reads it from and every other piece of held character state already
      # lives. See docs/BRIDGE_CONTRACT.md's injuries contract.
      State.record_health(data, server)

      wounds    = data.wounds || {}
      bleeders  = data.bleeders || {}
      poisoned  = data.poisoned
      diseased  = data.diseased

      count = wounds.values.flatten.size
      bleed = bleeders.values.flatten.size

      if count.zero? && bleed.zero? && !poisoned && !diseased
        server.log('Health: no wounds.')
      else
        server.log(
          "Health: #{count} wound(s), #{bleed} bleeding" \
          "#{poisoned ? ', poisoned' : ''}#{diseased ? ', diseased' : ''}",
          bleed.positive? ? 'warn' : 'info'
        )
        bleeders.each do |severity, list|
          Array(list).each do |w|
            part = begin
              w.body_part
            rescue StandardError
              'unknown'
            end
            server.log("  bleeding #{severity}: #{part}", 'warn')
          end
        end
      end

      [true, "#{count} wounds, #{bleed} bleeding"]
    end

    # Who is teaching a class here, and what skill.
    #
    # DR's own mechanic: someone runs a class, others LISTEN to it and learn
    # faster than they would alone. `assess teach` is how you find out what is
    # on offer in this room.
    #
    # Only teacher and skill are reported, deliberately. The game also states
    # a difficulty ("basic", "advanced", and so on, relative to what you
    # already know) and it is dropped, because Dan's answer when asked was
    # that players ignore difficulty and pick a class by the skill taught.
    # Parsing it would also have meant inventing a pattern against wording
    # nobody here can produce on demand - there is no live class to test
    # against - so the field would have been a guess wearing a data type.
    #
    # Lich's DRC.assess_teach does the command and the parsing, and it is
    # used rather than reimplemented: it is maintained against the real game
    # by people who play it, and a second parser here would drift from theirs
    # silently.
    def check_teaching(server)
      unless defined?(DRC) && DRC.respond_to?(:assess_teach)
        # Said plainly rather than reported as "nobody is teaching". A Lich
        # without this helper and a room with no classes are different facts,
        # and only one of them is about the room.
        server.log('This Lich build has no assess_teach, so classes cannot be listed.', 'warn')
        return [false, 'assess_teach unavailable']
      end

      found = begin
        DRC.assess_teach
      rescue StandardError => e
        server.log("Could not assess teaching: #{e.class}", 'warn')
        return [false, 'assess teach failed']
      end

      # {} is DRC.assess_teach's answer for BOTH "no one is teaching" and
      # "you are teaching a class yourself" - it returns early on either. So
      # an empty list is recorded as an empty list, which is a real answer,
      # and never left as nil, which means "never asked".
      list = (found || {}).map { |teacher, skill| { 'teacher' => teacher, 'skill' => skill } }
      State.record_teaching(list)

      if list.empty?
        server.log('No classes on offer here.')
      else
        list.each { |c| server.log("#{c['teacher']} is teaching #{c['skill']}") }
      end
      [true, "#{list.size} class(es)"]
    end

    # Join a class. The one command here that changes what the character is
    # doing, so it respects the Stop latch like every other acting intent.
    def listen_to(args, server)
      teacher = args.is_a?(Hash) ? args['teacher'] : nil
      teacher = teacher.to_s.strip
      # A name, not a sentence. This reaches a game command line, so anything
      # that is not a plain word is refused rather than sanitised - there is
      # no legitimate teacher name with a space or a semicolon in it.
      if teacher.empty? || teacher !~ /\A[A-Za-z'-]{2,30}\z/
        return [false, 'listen_to needs a teacher name']
      end
      if stop_requested?
        server.log('Listen refused: Stop is latched. Press Resume first.', 'warn')
        return [false, 'stopped']
      end

      ok = begin
        defined?(DRC) && DRC.respond_to?(:listen?) ? DRC.listen?(teacher) : nil
      rescue StandardError => e
        server.log("Could not listen to #{teacher}: #{e.class}", 'warn')
        return [false, 'listen failed']
      end

      # Three outcomes, not two. nil means this Lich could not be asked; false
      # means it asked and the game said no. Collapsing them would tell a
      # player to check their Lich install when the real answer is that the
      # class was full.
      if ok.nil?
        server.log('This Lich build has no listen helper.', 'warn')
        return [false, 'listen unavailable']
      end
      if ok
        server.log("Listening to #{teacher}.")
        [true, "listening to #{teacher}"]
      else
        server.log("#{teacher} is not teaching a class you can join.", 'warn')
        [false, 'not teaching']
      end
    end

    def stop_listening(server)
      Cmd.exec('stop listening', expect: /You stop listening|not listening/i, timeout: 5)
      server.log('Stopped listening.')
      [true, 'stopped listening']
    end

    # Put loose items away. Small, reversible, and a good first thing to let
    # the panel actually do: it touches inventory and nothing else.
    def stow_all(server)
      if stop_requested?
        server.log('Stow refused: Stop is latched. Press Resume first.', 'warn')
        return [false, 'stopped — press Resume']
      end

      moved = []
      hands = %w[right left]
      stopped_early = false

      hands.each do |hand|
        if stop_requested?
          stopped_early = true
          break
        end

        item = begin
          hand == 'right' ? GameObj.right_hand : GameObj.left_hand
        rescue StandardError
          nil
        end
        next if item.nil? || item.id.nil?

        name = begin
          item.noun.to_s
        rescue StandardError
          next
        end
        next if name.empty?

        line = Cmd.exec("stow #{name}", expect: Patterns.expect(:stow), timeout: 6)
        if line.nil?
          server.log("stow #{name}: no reply", 'warn')
        elsif line =~ /You put/i
          moved << name
        else
          server.log("stow #{name}: #{line}", 'warn')
        end
      end

      if stopped_early
        server.log("Stow stopped: #{moved.size} put away before Stop.", 'warn')
        return [true, "stopped, #{moved.size} stowed first"]
      end

      if moved.empty?
        server.log('Nothing loose in hand to stow.')
        [true, 'nothing to stow']
      else
        server.log("Stowed #{moved.join(', ')}.")
        [true, "stowed #{moved.size}"]
      end
    end

    def stop_all(server)
      # Signalled immediately, before anything else - this is what a macro or
      # stow_all mid-flight is watching for. Deliberately not behind CMD_LOCK:
      # the whole point is that Stop must reach here while one of those is
      # still holding it.
      request_stop!

      # A deliberate stop clears the loop detector: whatever happens next is
      # a fresh decision by the player, not a continuation.
      Runaway.reset
      killed = []
      me = State.safe(nil) { Script.current.name }
      State.safe([]) { Script.running }.each do |s|
        n = State.safe(nil) { s.name }
        next if n.nil? || n == me
        State.safe(nil) { Script.kill(n) }
        killed << n
      end
      server.log("Stopped: #{killed.empty? ? 'nothing was running' : killed.join(', ')}", 'warn')
      [true, killed.empty? ? 'nothing was running' : "stopped #{killed.size}"]
    end

    def pause_all(server)
      paused = []
      me = State.safe(nil) { Script.current.name }
      State.safe([]) { Script.running }.each do |s|
        n = State.safe(nil) { s.name }
        next if n.nil? || n == me
        next if State.safe(false) { s.paused? }
        State.safe(nil) { Script.pause(n) }
        paused << n
      end
      server.log("Paused: #{paused.join(', ')}") unless paused.empty?
      [true, "paused #{paused.size}"]
    end

    def resume_all(server)
      # The one place a latched Stop clears. See the note on @stop_requested
      # above: resuming is the human decision that means "continue", not the
      # next run_macro/stow_all that happens to arrive.
      clear_stop!
      reset_macro_flight!
      resumed = []
      me = State.safe(nil) { Script.current.name }
      State.safe([]) { Script.running }.each do |s|
        n = State.safe(nil) { s.name }
        next if n.nil? || n == me
        next unless State.safe(false) { s.paused? }
        State.safe(nil) { Script.unpause(n) }
        resumed << n
      end
      server.log("Resumed: #{resumed.join(', ')}") unless resumed.empty?
      [true, "resumed #{resumed.size}"]
    end

    # Emergency exit to safety. Declared a safety intent on the client
    # (SAFETY_INTENTS, alongside stop_all/pause/resume) with nothing behind it
    # here until now - the promise that this "always works" was never backed
    # by a handler, which is worse than not promising it at all.
    #
    # Deliberately narrow: flee is DragonRealms' own built-in escape, not a
    # composed routine of retreats and heals. A safety command earns "always
    # works" by doing one well-understood thing, not by getting cleverer.
    def escape(server)
      Runaway.reset
      line = Cmd.exec(
        'flee',
        expect: Patterns.expect(:escape),
        timeout: 6
      )
      server.log("Escape: #{line || 'no response from flee'}", line ? 'info' : 'warn')
      [true, line || 'flee sent, no response seen']
    end

    # Send literal game commands, from a macro or task-flow step the player
    # configured. Not sanitised or whitelisted the way start_script is -
    # these are commands the player wrote themselves, the same trust level as
    # typing them into Lich directly, and the type this intent exists for
    # (see bridge/types.ts) is exactly the words a player already trusted the
    # macro bar with.
    #
    # Runs the same way stow_all does: sequentially, in this thread, each
    # command waiting real roundtime through Cmd.exec. That means a Stop sent
    # while a long macro is mid-run queues behind it rather than pre-empting
    # it - a limitation this shares with every other multi-step intent here,
    # not something new. Flagged to prime rather than solved here: fixing it
    # needs the connection made non-blocking, which is a bigger change than
    # "make run_macro exist."
    MAX_MACRO_COMMANDS = 50

    def run_macro(args, server)
      raw = args.is_a?(Hash) ? args['commands'] : nil
      return [false, 'no commands given'] unless raw.is_a?(Array)

      commands = raw.map(&:to_s).map(&:strip).reject(&:empty?).first(MAX_MACRO_COMMANDS)
      return [false, 'no commands given'] if commands.empty?

      # Refused outright, not "stopped after 0 of N" - a latch already up
      # before this macro even started is a different event from one that
      # started and got interrupted mid-flight, and ok:true made them read
      # identically. The client only logs on ok:false (useAppStore.ts), so
      # "stopped after 0 of 3" at ok:true was a Stop that pressing a
      # macro-bar button afterwards could silently absorb with no trace
      # anywhere but a bridge log line nobody reads.
      if stop_requested?
        server.log('Macro refused: Stop is latched. Press Resume first.', 'warn')
        return [false, 'stopped — press Resume']
      end

      ran = 0
      commands.each do |command|
        if stop_requested?
          server.log("Macro stopped: #{ran} of #{commands.size} step(s) ran.", 'warn')
          return [true, "stopped after #{ran} of #{commands.size}"]
        end
        Cmd.exec(command, label: 'macro')
        ran += 1
      end

      [true, "#{ran} command(s) sent"]
    end

    MAX_ARMOR_ITEMS = 16

    # Named armor operations deliberately use DRCI's inventory-aware helpers
    # when dr-scripts provides them. They can locate a piece inside a player's
    # configured containers; the fallback remains useful on a plain Lich
    # install and sends only a single, tightly validated game command.
    def armor_manage(args, server)
      operation = args.is_a?(Hash) ? args['operation'].to_s : ''
      raw = args.is_a?(Hash) ? args['items'] : nil
      return [false, 'invalid armor operation'] unless %w[wear remove adjust swap].include?(operation)
      return [false, 'no armor items given'] unless raw.is_a?(Array)

      items = raw.first(MAX_ARMOR_ITEMS).map(&:to_s).map(&:strip).reject(&:empty?)
      return [false, 'no armor items given'] if items.empty?
      return [false, 'invalid armor item name'] if items.any? { |name| name.length > 160 || name.match?(/[\r\n;\x00-\x1f]/) }
      return [false, 'stopped — press Resume'] if stop_requested?

      requested_operation = operation
      ran = 0
      if operation == 'swap'
        replacement, *old_pieces = items
        old_pieces.each do |name|
          return [true, "stopped after #{ran} of #{items.size}"] if stop_requested?
          target = name.sub(/\A(?:a|an|some|the)\s+/i, '')
          if defined?(DRCI) && DRCI.respond_to?(:remove_item?)
            DRCI.remove_item?(name)
          else
            Cmd.exec("remove #{target}", label: 'armor')
          end
          ran += 1
        end
        items = [replacement]
        operation = 'wear'
      end

      items.each do |name|
        return [true, "stopped after #{ran} of #{items.size}"] if stop_requested?
        target = name.sub(/\A(?:a|an|some|the)\s+/i, '')
        case operation
        when 'wear'
          if defined?(DRCI) && DRCI.respond_to?(:wear_item?)
            DRCI.wear_item?(name)
          else
            Cmd.exec("wear #{target}", label: 'armor')
          end
        when 'remove'
          if defined?(DRCI) && DRCI.respond_to?(:remove_item?)
            DRCI.remove_item?(name)
          else
            Cmd.exec("remove #{target}", label: 'armor')
          end
        when 'adjust'
          Cmd.exec("adjust #{target}", label: 'armor')
        end
        ran += 1
      end

      server.log("Armor: #{requested_operation} #{ran} item(s).")
      [true, "#{requested_operation} #{ran} armor item(s)"]
    rescue StandardError => e
      server.log("Armor #{operation} failed: #{e.message}", 'warn')
      [false, "armor #{operation} failed: #{e.message}"]
    end
  end

  # ----------------------------------------------------------------- server --

  class Server
    # Exposed for server_test.rb only. The suite drives handle_message
    # directly and asserts exact response counts per intent - push_loop's
    # own 1s-interval broadcasts are real, wanted production behavior, but
    # racing them against every one of those exact-count reads is not
    # something this test's assertions were designed to tolerate. Killing
    # this one thread after start is a test-only concession; nothing about
    # push_loop itself changes.
    attr_reader :push_thread

    def initialize(port = DEFAULT_PORT)
      @port    = port
      @clients = []
      @lock    = Mutex.new
      @running = false
      @last_status = nil
    end

    def start
      begin
        @server = TCPServer.new('127.0.0.1', @port)
      rescue Errno::EADDRINUSE
        respond "[companion] port #{@port} is already in use. Another bridge may be running."
        return false
      end
      @running = true

      # A fresh token per start, so one that leaked yesterday is worthless.
      # Before the accept loop, or the first client could beat it.
      Companion.write_token!

      respond "[companion] bridge v#{BRIDGE_VERSION} listening on ws://127.0.0.1:#{@port}#{PATH}"

      Trace.sink = ->(row) { trace(row) }

      @accept_thread = Thread.new { accept_loop }
      @push_thread   = Thread.new { push_loop }
      true
    end

    def stop
      @running = false
      @lock.synchronize do
        @clients.each do |c|
          begin
            c.write(WS.close_frame(1001, 'bridge stopping'))
            c.close
          rescue StandardError
            nil
          end
        end
        @clients.clear
      end
      begin
        @server&.close
      rescue StandardError
        nil
      end
      respond '[companion] bridge stopped.'
    end

    def running?
      @running
    end

    # ------------------------------------------------------------- plumbing --

    def accept_loop
      while @running
        ready = IO.select([@server], nil, nil, 0.5)
        next unless ready
        begin
          sock = @server.accept_nonblock
        rescue IO::WaitReadable, Errno::EINTR
          next
        rescue StandardError
          next
        end
        Thread.new(sock) { |s| serve(s) }
      end
    rescue StandardError => e
      respond "[companion] accept loop ended: #{e.message}"
    end

    def serve(sock)
      return unless handshake(sock)

      # The token, before anything is sent and before the socket joins the
      # client list.
      #
      # Order matters and is the whole design. An unauthenticated socket never
      # reaches `@clients`, so it never receives a broadcast - which means an
      # attacker who gets as far as the handshake still learns nothing about
      # the character while failing. Authenticate first, then say hello.
      unless authenticate(sock)
        begin
          sock.close
        rescue StandardError
          nil
        end
        return
      end

      @lock.synchronize { @clients << sock }
      send_to(sock, type: 'hello', protocol: PROTOCOL,
                    lichVersion: (defined?(LICH_VERSION) ? LICH_VERSION.to_s : 'unknown'),
                    bridgeVersion: BRIDGE_VERSION,
                    # Which gates are up, so a halved boundary is visible
                    # somewhere a person actually looks rather than only in
                    # Lich's log, which the app never reads.
                    auth: Companion.auth_mode,
                    authNote: Companion.auth_note,
                    # BRIDGE_CONTRACT.md's implemented-intents contract: a
                    # real enumeration of Intents.dispatch's own routing
                    # table, so this can never drift from what dispatch
                    # actually does. Absent on any bridge old enough not to
                    # send it at all; present-and-not-listed is the honest
                    # "not implemented", never inferred from absence.
                    implementedIntents: Intents.implemented_intents)
      send_to(sock, type: 'status', payload: State.status)
      send_to(sock, type: 'inventory', payload: State.inventory)
      send_to(sock, type: 'scripts', payload: State.other_scripts)

      while @running
        frame = WS.read_frame(sock)
        break if frame.nil?
        opcode, payload = frame

        case opcode
        when 0x8 # close
          break
        when 0x9 # ping
          @lock.synchronize { sock.write(WS.encode(payload, 0xA)) rescue nil }
        when 0x1, 0x2
          # A thread per message, not a call inline. Before this, the loop
          # blocked on handle_message until it returned - so a stop_all sent
          # while run_macro was mid-flight sat unread in the OS receive
          # buffer, because reading it is this same loop coming back around,
          # which a blocking macro call prevented. Intents.handle's CMD_LOCK
          # is what keeps this safe: two command-sending intents now queue
          # behind that lock instead of running concurrently, while stop_all
          # and every read-only query never touch it and so never wait.
          Thread.new(payload) do |p|
            begin
              handle_message(sock, p)
            rescue StandardError => e
              Companion.log_error("message handler raised: #{e.message}")
            end
          end
        end
      end
    rescue StandardError
      nil
    ensure
      @lock.synchronize { @clients.delete(sock) }
      begin
        sock.close
      rescue StandardError
        nil
      end
    end

    # The first frame must be `{"type":"auth","token":"..."}`, within a second.
    #
    # A deadline rather than a wait, because a client that has not
    # authenticated is a client that might be probing, and "how long will it
    # let me sit here" is a question with no good answer. One second is
    # generous for a local socket and short enough that a scan gets nothing.
    #
    # Comparison is constant-time. The window is small and the attacker is
    # local, so a timing attack here is a stretch - but the cost is four lines
    # and the alternative is arguing about how much of a stretch, which is a
    # conversation about the wrong thing.
    def authenticate(sock)
      expected = Companion.auth_token
      return true if expected.nil? || expected.empty?

      deadline = Time.now + TOKEN_GRACE_SECONDS
      while Time.now < deadline
        ready = IO.select([sock], nil, nil, 0.1)
        next unless ready

        frame = WS.read_frame(sock)
        return false if frame.nil?

        opcode, payload = frame
        next unless [0x1, 0x2].include?(opcode)

        msg = begin
          JSON.parse(payload)
        rescue StandardError
          nil
        end
        offered = msg.is_a?(Hash) && msg['type'] == 'auth' ? msg['token'].to_s : nil
        return true if offered && Companion.same_secret?(offered, expected)

        # One attempt. A client that sent the wrong thing does not get to keep
        # guessing inside the grace window.
        Companion.log_error('refused a connection: bad or missing token')
        begin
          sock.write(WS.encode(JSON.generate(type: 'error', message: 'unauthorised')))
        rescue StandardError
          nil
        end
        return false
      end

      Companion.log_error('refused a connection: no token within the grace period')
      false
    rescue StandardError
      false
    end

    def handshake(sock)
      request = +''
      # Read headers, bounded so a non-WebSocket client cannot hang a thread.
      deadline = Time.now + 5
      while Time.now < deadline
        break if request.include?("\r\n\r\n")
        ready = IO.select([sock], nil, nil, 0.5)
        next unless ready
        begin
          request << sock.readpartial(4096)
        rescue EOFError, IOError
          return false
        end
        return false if request.bytesize > 16_384
      end
      return false unless request.include?("\r\n\r\n")

      request_line = request.lines.first.to_s
      unless request_line.include?(PATH)
        sock.write("HTTP/1.1 404 Not Found\r\nConnection: close\r\n\r\n")
        return false
      end

      # Origin, before the key, because a caller who should not be here is not
      # made acceptable by having sent a well-formed key.
      #
      # Absent is allowed: that is what a non-browser sends. Present and
      # unlisted is refused, which is every web page in the world.
      origin = request[/^Origin:\s*(\S+)/i, 1]
      if origin && !ALLOWED_ORIGINS.include?(origin)
        # Logged with the origin it saw. A refusal that does not name what it
        # refused is a bug report nobody can act on, and if a Tauri version
        # invents a new scheme this line is the whole diagnosis.
        Companion.log_error("refused a connection from origin #{origin.inspect}")
        sock.write("HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n")
        return false
      end

      key = request[/Sec-WebSocket-Key:\s*(\S+)/i, 1]
      unless key
        sock.write("HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n")
        return false
      end

      sock.write(
        "HTTP/1.1 101 Switching Protocols\r\n" \
        "Upgrade: websocket\r\n" \
        "Connection: Upgrade\r\n" \
        "Sec-WebSocket-Accept: #{WS.accept_key(key)}\r\n\r\n"
      )
      true
    rescue StandardError
      false
    end

    def handle_message(sock, raw)
      msg = begin
        JSON.parse(raw)
      rescue StandardError
        send_to(sock, type: 'error', message: 'invalid JSON')
        return
      end
      return unless msg.is_a?(Hash)

      case msg['type']
      when 'ping'
        send_to(sock, type: 'log', line: 'pong')
      when 'subscribe', 'get_status'
        send_to(sock, type: 'status', payload: State.status)
      when 'get_inventory'
        send_to(sock, type: 'inventory', payload: State.inventory)
      when 'intent'
        intent = msg['intent'].to_s
        ok, detail = Intents.handle(intent, msg['args'], self)
        send_to(sock, type: 'intent_ack', intent: intent, ok: ok, detail: detail)
        broadcast(type: 'status', payload: State.status)
        broadcast(type: 'scripts', payload: State.other_scripts)
      else
        send_to(sock, type: 'error', message: "unknown message type: #{msg['type']}")
      end
    end

    def send_to(sock, hash)
      frame = WS.encode(JSON.generate(hash))
      @lock.synchronize do
        begin
          sock.write(frame)
        rescue StandardError
          @clients.delete(sock)
        end
      end
    end

    def broadcast(hash)
      frame = WS.encode(JSON.generate(hash))
      @lock.synchronize do
        @clients.dup.each do |c|
          begin
            c.write(frame)
          rescue StandardError
            @clients.delete(c)
          end
        end
      end
    end

    def log(line, level = 'info')
      broadcast(type: 'log', line: line, level: level)
    end

    # Push a trace row to every connected panel.
    def trace(row)
      broadcast(type: 'trace', row: row)
    end

    # Push status on a slow tick, and immediately when something changed.
    # Skills are large, so compare a cheap digest rather than the whole payload.
    def push_loop
      last_scripts = nil
      while @running
        sleep 1
        next if @clients.empty?

        begin
          status = State.status
          digest = [
            status['vitals'], status['situation'], status['location'],
            status['activity'], status['favors']
          ].to_s

          if digest != @last_status
            @last_status = digest
            broadcast(type: 'status', payload: status)
          end

          scripts = State.other_scripts
          if scripts != last_scripts
            last_scripts = scripts
            broadcast(type: 'scripts', payload: scripts)
          end
        rescue StandardError
          nil
        end
      end
    end
  end
end

# -------------------------------------------------------------------- entry --

arg = Script.current.vars[1].to_s.strip.downcase

if arg == 'stop'
  if $companion_bridge&.running?
    $companion_bridge.stop
    $companion_bridge = nil
  else
    respond '[companion] no bridge is running.'
  end
  exit
end

if $companion_bridge&.running?
  respond '[companion] bridge is already running. Use ";companion_bridge stop" first.'
  exit
end

port = arg =~ /^\d+$/ ? arg.to_i : Companion::DEFAULT_PORT

$companion_bridge = Companion::Server.new(port)
exit unless $companion_bridge.start

Script.at_exit do
  $companion_bridge&.stop
  $companion_bridge = nil
end

# Keep the script alive so Lich does not reap it while the sockets are open.
sleep 1 while $companion_bridge&.running?
