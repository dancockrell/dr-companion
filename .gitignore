
!.vscode/extensions.json
# Editor directories and files
# Logs
# Tauri build output
*.local
*.log
*.njsproj
*.ntvs*
*.sln
*.suo
*.sw?
.DS_Store
.idea
.vscode/*
# The scraped wiki data is published, not local scratch: the hourly workflow
# commits it here and clients fetch it from the repo. Ignoring it would mean
# that workflow ran every hour forever and committed nothing.
#   data/elanthipedia/  <- deliberately not ignored
data/kb/
dist
dist-ssr
lerna-debug.log*
logs
node_modules
npm-debug.log*
__pycache__/
*.pyc
pnpm-debug.log*
src-tauri/gen
src-tauri/target

# Ruby4Lich5.exe, 65 MB and rebuilt by upstream on their own schedule -
# belongs beside the release it ships in, not in git history forever. Same
# reasoning as public/rooms/ below. tools/vendor-fetch.mjs populates this
# before a release build; src-tauri/tauri.conf.json bundles whatever is here.
src-tauri/vendor/
yarn-debug.log*
yarn-error.log*

# Generated art inputs and outputs. Regenerable from the map data and the
# bestiary, and room-prompts.json alone is 20 MB.
data/art/out/
data/art/manifest.json
data/art/room-prompts.json

# Superseded renders held outside the repo, never committed.
quarantine*/

# Generated from data/art/room-prompts.json by tools/build-room-text.mjs.
public/roomtext/

# Ambient/music/radio audio, sourced by data/audio/manifest.json and pulled
# by tools/vendor-audio.mjs. Same reasoning as public/rooms/ below: fetchable
# from the manifest, not source. The manifest itself is tracked - it is the
# license record and the only copy of "where this came from" that matters.
public/audio/

# Room art WAS excluded here on the assumption of one unique image per room -
# 17,750 rooms at a mean 178 KB, 3.0 GB against the repository. That assumption
# stopped being true on 28 Aug 2026: tools/publish-room-art.mjs hard-links most
# rooms to a shared archetype/place image rather than rendering one per room
# (Dan's own call - there is no render budget for that, and a road is a road).
# Measured against the actual working tree (issue #8): 9,719 room-file paths,
# but only 2,846 unique inodes behind them - 58.8 MB of real content, not 3 GB.
# Git's own object store deduplicates by content hash the same way a hard link
# deduplicates by inode - confirmed empirically (50 copies of a 1 MB file cost
# ~1 MB of .git, not 50 MB) - so committing every room path costs the unique
# bytes behind it, not 17,750 times that. Tracked directly now, same as
# creatures/portraits. The generated stand-in still covers whatever a given
# checkout has not rendered yet, which stays true regardless of where the art
# lives.

# Daemon runtime state: a pid lock and a status file rewritten every render.
data/art/daemon-status.json
data/art/daemon.lock
data/art/daemon.stop
data/art/failures.json
data/art/comfy-extra-model-paths.yaml
data/art/comfy-manual*.log

# Account credentials for tools/save-lich-entry.rb. Never committed, never
# printed by that script, and deletable the moment the Lich entry is saved.
tools/lich-credentials.txt
